async function replaceFile(f, file, ov, closeParent){
  if(!canManageFile(f)){ toast("You can't replace this file.", true); return; }
  if(file.size>MAX_BYTES){ toast(`Too large — max ${fmtSize(MAX_BYTES)} for a direct upload. Use a link instead.`, true); return; }
  toast("Replacing…");
  const reader=new FileReader();
  reader.onload=async()=>{
    const dataUrl=reader.result;
    await loadDir();
    const cur=DIR.files.find(x=>x.id===f.id); if(!cur){ return; }
    const rev=cur.rev||1;
    // archive the current version
    const oldBlob=await getBlob(cur.id);
    if(oldBlob){ const hkey="fdb.hist."+cur.id+".v"+rev; await setBlobAt(hkey, oldBlob);
      cur.history=cur.history||[]; cur.history.push({rev, name:cur.name, size:cur.size, mime:cur.mime, at:cur.uploadedAt, by:cur.uploadedBy, blobKey:hkey}); }
    // store new content as current
    const ok=await setBlob(cur.id, dataUrl);
    if(!ok){ toast("Couldn't store the new version (size limit).", true); return; }
    cur.rev=rev+1; cur.size=file.size; cur.mime=file.type||cur.mime; cur.name=file.name||cur.name; cur.uploadedAt=Date.now();
    // refresh thumbnail
    if((file.type||"").startsWith("image/")){ const t=await makeThumb(dataUrl); if(t){ await store.set(THUMB(cur.id),t,true); cur.hasThumb=true; } } else { cur.hasThumb=false; await store.del(THUMB(cur.id),true); }
    await saveDir();
    if(closeParent) closeParent();
    renderApp();
    openFileDetail(f.id);
    toast("New version saved");
  };
  reader.readAsDataURL(file);
}

