  ov.querySelector("#sn-go").onclick=async()=>{ const v=inp.value.trim(); if(!v)return; const pin=ov.querySelector("#sp").value.trim();
    const id=uid(); DIR.members.push({id,name:v,color:AVATAR_COLORS[DIR.members.length%AVATAR_COLORS.length], pin:pin?hashCode(pin):null, role:"member"});
    await saveDir(); close(); await signIn(id, rememberMe); renderApp(); toast("Welcome, "+v.split(" ")[0]); };
