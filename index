function deleteFile(f, closeParent){
  const {ov,close}=modal(`
    <div class="modal-head"><div><h3>Delete file</h3><div class="sub">This removes it for everyone. This can't be undone.</div></div><button class="x" data-close>${I.x}</button></div>
    <div class="modal-body"><p style="font-size:14px;color:var(--ink-2)">Delete <strong>${esc(f.name)}</strong> from the library?</p></div>
    <div class="modal-foot"><button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-danger" id="del-yes">Delete file</button></div>`);
  ov.querySelector("#del-yes").onclick=async()=>{ await delBlob(f.id); await store.del(THUMB(f.id),true); for(const h of (f.history||[])){ if(h.blobKey) await delBlobAt(h.blobKey); } DIR.files=DIR.files.filter(x=>x.id!==f.id); await saveDir(); close(); if(closeParent)closeParent(); renderApp(); toast("File deleted"); };
}

/* ---------- highlighting / annotations ---------- */
function regionNumbers(f){
  const map={}; let n=0;
  (f.comments||[]).slice().sort((a,b)=>a.at-b.at).forEach(c=>{ if(c.anchor && c.anchor.type==="rect"){ n++; map[c.id]=n; } });
  return map;
}
function rectsOf(anchor){ if(!anchor) return []; if(anchor.rects) return anchor.rects; if(anchor.type==="rect" && anchor.x!=null) return [{x:anchor.x,y:anchor.y,w:anchor.w,h:anchor.h}]; return []; }
function anchorChip(f,c){
  if(!c.anchor) return "";
  if(c.anchor.type==="rect"){ const n=regionNumbers(f)[c.id]; const cnt=rectsOf(c.anchor).length; return `<button class="anchor-chip" data-flash="${c.id}">▣ Region ${n}${cnt>1?` · ${cnt} areas`:""}</button>`; }
  if(c.anchor.type==="text"){ const q=c.anchor.quote||""; return `<button class="anchor-chip" data-flash="${c.id}">“${esc(q.slice(0,42))}${q.length>42?"…":""}”</button>`; }
  return "";
}
function setupImageAnnot(ov, f){
  const stage=ov.querySelector("#hlStage"), cap=ov.querySelector("#hlCapture"), toggle=ov.querySelector("#hlToggle");
  const canAnnotate = canView(myAccess(f));
  if(!canAnnotate){ toggle.style.display="none"; return; }
  const setLabel=()=>{ const n=(ov._pending&&ov._pending.rects)?ov._pending.rects.length:0; toggle.textContent=ov._hlMode?(n?`✎ Drawing — ${n} area${n!==1?"s":""} (drag for more, click Done)`:"✎ Drawing… (drag boxes)"):(n?`✎ ${n} area${n!==1?"s":""} — add more`:"✎ Highlight areas"); };
  toggle.onclick=()=>{ ov._hlMode=!ov._hlMode; cap.classList.toggle("on",ov._hlMode); toggle.classList.toggle("on",ov._hlMode); setLabel(); if(!ov._hlMode){ renderComments(ov,f); const ci=ov.querySelector("#c-input"); if(ci) ci.focus(); } };
  let start=null, tmp=null;
  const rectFromEvent=(e)=>{ const r=stage.getBoundingClientRect(); const cx=(e.touches?e.touches[0].clientX:e.clientX); const cy=(e.touches?e.touches[0].clientY:e.clientY); return {x:Math.min(1,Math.max(0,(cx-r.left)/r.width)), y:Math.min(1,Math.max(0,(cy-r.top)/r.height))}; };
  const down=(e)=>{ if(!ov._hlMode) return; e.preventDefault(); start=rectFromEvent(e); tmp=document.createElement("div"); tmp.className="hl-box pending"; ov.querySelector("#hlLayer").appendChild(tmp); document.addEventListener("pointermove",move); document.addEventListener("pointerup",up); };
  const move=(e)=>{ if(!start||!tmp) return; const p=rectFromEvent(e); const x=Math.min(start.x,p.x),y=Math.min(start.y,p.y),w=Math.abs(p.x-start.x),h=Math.abs(p.y-start.y); Object.assign(tmp.style,{left:x*100+"%",top:y*100+"%",width:w*100+"%",height:h*100+"%"}); };
  const up=(e)=>{ document.removeEventListener("pointermove",move); document.removeEventListener("pointerup",up); if(!start||!tmp){ start=tmp=null; return; } const p=rectFromEvent(e); const x=Math.min(start.x,p.x),y=Math.min(start.y,p.y),w=Math.abs(p.x-start.x),h=Math.abs(p.y-start.y); start=null;
    if(w<0.02||h<0.02){ tmp.remove(); tmp=null; return; }
    if(!ov._pending || ov._pending.type!=="rect") ov._pending={type:"rect",rects:[]};
    ov._pending.rects.push({x,y,w,h});
    redrawImageHighlights(ov,f); setLabel(); tmp=null; };
  cap.addEventListener("pointerdown",down);
  setLabel();
}
function redrawImageHighlights(ov, f){
  const layer=ov.querySelector("#hlLayer"); if(!layer) return;
  const nums=regionNumbers(f);
  layer.innerHTML="";
  (f.comments||[]).forEach(c=>{ if(c.anchor && c.anchor.type==="rect"){
    rectsOf(c.anchor).forEach((r,i)=>{
      const b=document.createElement("div"); b.className="hl-box"; b.dataset.cid=c.id;
      Object.assign(b.style,{left:r.x*100+"%",top:r.y*100+"%",width:r.w*100+"%",height:r.h*100+"%"});
      if(i===0) b.innerHTML=`<span class="hl-num">${nums[c.id]||""}</span>`;
      b.onclick=()=>flashComment(ov,c.id);
      layer.appendChild(b);
    });
  }});
  if(ov._pending && ov._pending.type==="rect"){
    (ov._pending.rects||[]).forEach(p=>{ const b=document.createElement("div"); b.className="hl-box pending";
      Object.assign(b.style,{left:p.x*100+"%",top:p.y*100+"%",width:p.w*100+"%",height:p.h*100+"%"}); layer.appendChild(b); });
  }
}
function setupTextAnnot(ov, f){
  const pre=ov.querySelector("#hlText"); if(!pre) return;
  const canAnnotate = canView(myAccess(f));
  if(!canAnnotate) return;
  pre.addEventListener("mouseup",()=>{
    const sel=window.getSelection(); if(!sel||sel.isCollapsed) return;
    if(!pre.contains(sel.anchorNode)||!pre.contains(sel.focusNode)) return;
    const q=sel.toString().trim(); if(q.length<2) return;
    ov._pending={type:"text",quote:q.slice(0,300)}; sel.removeAllRanges();
    renderComments(ov,f); const ci=ov.querySelector("#c-input"); if(ci) ci.focus();
  });
}
function wrapTextHighlights(ov, f){
  const pre=ov.querySelector("#hlText"); if(!pre||ov._text==null) return;
  const text=ov._text;
  const ranges=[];
  (f.comments||[]).forEach(c=>{ if(c.anchor && c.anchor.type==="text" && c.anchor.quote){ const i=text.indexOf(c.anchor.quote); if(i>=0) ranges.push({s:i,e:i+c.anchor.quote.length,cid:c.id}); }});
  ranges.sort((a,b)=>a.s-b.s);
  let out="", pos=0, lastEnd=-1;
  for(const r of ranges){ if(r.s<lastEnd) continue; out+=esc(text.slice(pos,r.s)); out+=`<mark class="hl-mark" data-cid="${r.cid}">${esc(text.slice(r.s,r.e))}</mark>`; pos=r.e; lastEnd=r.e; }
  out+=esc(text.slice(pos));
  pre.innerHTML=out;
  pre.querySelectorAll(".hl-mark").forEach(mk=> mk.onclick=()=>flashComment(ov,mk.dataset.cid));
  // re-bind selection handler (innerHTML replaced children)
  setupTextAnnot(ov, f);
}
function flashAnchor(ov, f, c){
  if(!c.anchor) return;
  const prev=ov.querySelector("#prev"); if(prev) prev.scrollIntoView({behavior:"smooth",block:"nearest"});
  if(c.anchor.type==="rect"){ ov.querySelectorAll(`.hl-box[data-cid="${c.id}"]`).forEach(el=>{ el.classList.add("flash"); setTimeout(()=>el.classList.remove("flash"),1400); }); return; }
  if(c.anchor.type==="text"){ const el=ov.querySelector(`.hl-mark[data-cid="${c.id}"]`); if(el){ el.classList.add("flash"); setTimeout(()=>el.classList.remove("flash"),1400); } }
}
function flashComment(ov, cid){
  const item=ov.querySelector(`.c-item[data-cid="${cid}"]`);
  if(item){ item.scrollIntoView({behavior:"smooth",block:"center"}); item.classList.add("flash"); setTimeout(()=>item.classList.remove("flash"),1400); }
}

function accessForMember(f, mid){ if(f.uploadedBy===mid) return "owner"; return tierMax((f.access&&f.access[mid])||"none", folderAccessFor(f.folderId,mid)); }
function fileAudience(f){ return DIR.members.filter(m=> canView(accessForMember(f,m.id))); }
function parseMentions(text, f){
  const ids=[];
  fileAudience(f).slice().sort((a,b)=>b.name.length-a.name.length).forEach(m=>{
    const re=new RegExp("@"+m.name.replace(/[.*+?^${}()|[\]\\]/g,"\\$&"),"i");
    if(re.test(text)) ids.push(m.id);
  });
  return [...new Set(ids)];
}
function renderCommentText(f, text){
  let html=esc(text);
  fileAudience(f).slice().sort((a,b)=>b.name.length-a.name.length).forEach(m=>{
    const name=esc(m.name);
    html=html.replace(new RegExp("@"+name.replace(/[.*+?^${}()|[\]\\]/g,"\\$&"),"gi"), `<span class="mention">@${name}</span>`);
  });
  return html;
}
function setupMentionAutocomplete(input, f){
  const aud=fileAudience(f).filter(m=>m.id!==ME);
  if(aud.length===0) return;
  let pop=null;
  const close=()=>{ if(pop){ pop.remove(); pop=null; } };
  input.addEventListener("input",()=>{
    const val=input.value.slice(0,input.selectionStart);
    const mtok=/@([A-Za-z]{0,20})$/.exec(val);
    close();
    if(!mtok) return;
    const q=mtok[1].toLowerCase();
    const matches=aud.filter(m=> m.name.toLowerCase().includes(q)).slice(0,6);
    if(matches.length===0) return;
    pop=document.createElement("div"); pop.className="mention-pop";
    pop.innerHTML=matches.map(m=>`<button data-mid="${m.id}" data-name="${esc(m.name)}">${avatar(m)}<span>${esc(m.name)}</span></button>`).join("");
    input.parentNode.style.position="relative"; input.parentNode.appendChild(pop);
    pop.querySelectorAll("button").forEach(b=> b.onclick=()=>{
      const name=b.dataset.name;
      const start=input.selectionStart;
      const before=input.value.slice(0,start).replace(/@([A-Za-z]{0,20})$/, "@"+name+" ");
      const after=input.value.slice(start);
      input.value=before+after; input.focus();
      const pos=before.length; input.setSelectionRange(pos,pos);
      close();
    });
  });
  input.addEventListener("blur",()=> setTimeout(close,180));
}

function timeAgo(ts){
  const s=Math.floor((Date.now()-ts)/1000);
  if(s<60) return "just now";
  const m=Math.floor(s/60); if(m<60) return m+"m ago";
  const h=Math.floor(m/60); if(h<24) return h+"h ago";
  const d=Math.floor(h/24); if(d<7) return d+"d ago";
  return fmtDate(ts);
}
function renderComments(ov, f){
  const box=ov.querySelector("#comments"); if(!box) return;
  const list=(f.comments||[]).slice().sort((a,b)=>a.at-b.at);
  const myA=myAccess(f);
  const p=ov._pending;
  const pendingChip = p ? `<div class="c-pending">Attaching: <strong>${p.type==="rect"?`${(p.rects||[]).length} image area${(p.rects||[]).length!==1?"s":""}`:`“${esc((p.quote||"").slice(0,42))}${(p.quote||"").length>42?"…":""}”`}</strong><button class="c-pending-x" id="c-clear" aria-label="Remove attachment">${I.x}</button></div>` : "";

  box.innerHTML=`
    <div class="c-title">Comments <span class="c-count">${list.length}</span></div>
    <div class="c-list">${
      list.length? list.map(c=>{
        const m=memberById(c.by);
        const canDel = c.by===ME || canManageFile(f);
        return `<div class="c-item" data-cid="${c.id}">
          ${m?avatar(m):`<span class="avatar" style="background:var(--mist)">?</span>`}
          <div class="c-main">
            <div class="c-head"><span class="c-name">${m?esc(m.name):"Unknown"}</span><span class="c-time">${timeAgo(c.at)}</span>${canDel?`<button class="c-del" data-cid="${c.id}" aria-label="Delete comment">${I.x}</button>`:""}</div>
            ${anchorChip(f,c)}
            <div class="c-text">${renderCommentText(f,c.text)}</div>
          </div>
        </div>`;
      }).join("") : `<div class="c-empty">No comments yet. Anyone with access can start the thread${(ov.querySelector("#hlStage")||ov.querySelector("#hlText"))?" — select text or draw a box to comment on a specific part":""}.</div>`
    }</div>
    ${pendingChip}
    <div class="c-add">
      <textarea id="c-input" rows="1" placeholder="${p?"Comment on the highlighted part…":"Add a comment…"}" maxlength="2000"></textarea>
      <button class="btn btn-accent btn-sm" id="c-send">Post</button>
    </div>`;

  const input=box.querySelector("#c-input");
  setupMentionAutocomplete(input, f);
  const send=async()=>{
    const t=input.value.trim(); if(!t) return;
    const anchor=ov._pending||null;
    const mentions=parseMentions(t, f);
    await loadDir();
    const cur=DIR.files.find(x=>x.id===f.id); if(!cur) return;
    cur.comments = cur.comments || [];
    const cid=uid();
    cur.comments.push({id:cid, by:ME, text:t.slice(0,2000), at:Date.now(), anchor, mentions});
    f.comments=cur.comments; ov._pending=null;
    // notifications: mentioned people, plus the file owner (activity on their file)
    mentions.forEach(mid=> pushNotif(mid, "mention", f.id, cid, ME));
    if(cur.uploadedBy!==ME && !mentions.includes(cur.uploadedBy)) pushNotif(cur.uploadedBy, "comment", f.id, cid, ME);
    await saveDir();
    renderComments(ov, f);
    if(ov.querySelector("#hlLayer")) redrawImageHighlights(ov, f);
    if(ov.querySelector("#hlText")) wrapTextHighlights(ov, f);
    if(document.getElementById("main")) renderMain();
  };
  box.querySelector("#c-send").onclick=send;
  input.addEventListener("keydown",e=>{ if(e.key==="Enter" && (e.metaKey||e.ctrlKey)){ e.preventDefault(); send(); } });
  input.addEventListener("input",()=>{ input.style.height="auto"; input.style.height=Math.min(input.scrollHeight,140)+"px"; });
  if(box.querySelector("#c-clear")) box.querySelector("#c-clear").onclick=()=>{ ov._pending=null; if(ov.querySelector("#hlLayer")) redrawImageHighlights(ov,f); renderComments(ov,f); };
  box.querySelectorAll(".c-del").forEach(b=> b.onclick=async()=>{
    await loadDir();
    const cur=DIR.files.find(x=>x.id===f.id); if(!cur) return;
    cur.comments=(cur.comments||[]).filter(c=>c.id!==b.dataset.cid);
    f.comments=cur.comments;
    await saveDir(); renderComments(ov, f);
    if(ov.querySelector("#hlLayer")) redrawImageHighlights(ov, f);
    if(ov.querySelector("#hlText")) wrapTextHighlights(ov, f);
    if(document.getElementById("main")) renderMain(); toast("Comment deleted");
  });
  box.querySelectorAll(".anchor-chip").forEach(b=> b.onclick=()=>{ const c=(f.comments||[]).find(x=>x.id===b.dataset.flash); if(c) flashAnchor(ov,f,c); });
}

