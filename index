function fileCard(f){
  const a=myAccess(f);
  const up=memberById(f.uploadedBy);
  const isLink=f.kind==="link";
  const isImg=!isLink && (f.mime||"").startsWith("image/");
  const tier = a==="owner"?["tier-owner","Owner"]:a==="edit"?["tier-edit","Can edit"]:a==="readonly"?["tier-read","Read-only"]:["tier-view","View only"];
  const recips = DIR.members.filter(m=> m.id!==f.uploadedBy && f.access && f.access[m.id] && f.access[m.id]!=="none");
  const shown = recips.slice(0,3);
  const extra = recips.length-shown.length;
  const stack = `<div class="stack">${up?avatar(up):""}${shown.map(m=>avatar(m)).join("")}${extra>0?`<span class="more">+${extra}</span>`:""}</div>`;
  const sizeLabel = isLink ? (f.sizeLabel?esc(f.sizeLabel):"External link") : fmtSize(f.size);
  const typeLabel = isLink ? "LINK" : extOf(f.name);
  const unread = unreadCount(f);

  return `<div class="card" data-file="${f.id}" draggable="true" tabindex="0" role="button" aria-label="${esc(f.name)}">
    <div class="thumb" ${isImg&&f.hasThumb?`data-thumb="${f.id}"`:""}>
      <span class="filetype">${typeLabel}</span><span class="ficon">${isLink?I.linkBig:I.file}</span>
      ${unread>0?`<span class="new-badge">${unread} new</span>`:""}
    </div>
    <div class="card-body">
      <div class="fname">${esc(f.name)}</div>
      <div class="fmeta"><span>${sizeLabel}</span><span>·</span><span>${fmtDate(f.uploadedAt)}</span>${(f.comments&&f.comments.length)?`<span>·</span><span>${f.comments.length} comment${f.comments.length!==1?"s":""}</span>`:""}</div>
      <div class="frow">
        ${stack}
        <span class="card-right"><button class="fav-btn ${FAV.includes(f.id)?"on":""}" data-fav="${f.id}" aria-label="Favorite" title="Favorite">${FAV.includes(f.id)?I.starFill:I.star}</button><span class="tier-badge ${tier[0]}">${tier[1]}</span></span>
      </div>
    </div>
  </div>`;
}

