      <td style="padding:10px 12px;display:flex;align-items:center;gap:10px">${avatar(m)}<span>${esc(m.name)}${m.id===ME?' <span style="color:var(--slate-2);font-size:10px">(you)</span>':""}</span></td>
      <td style="padding:10px 12px"><span class="role-tag ${m.role==="admin"?"admin":""}">${roleLabel}</span></td>
      <td style="padding:10px 12px;font-family:var(--num);font-size:12px;color:var(--slate)">${fcount}</td>
      <td style="padding:10px 12px;display:flex;align-items:center;gap:8px">
        ${hasBuilderRole()?`<select class="role-sel dash-role-sel" data-mid="${m.id}" ${m.id===ME?"disabled":""}>
          ${["admin","builder","member"].map(r=>`<option value="${r}" ${(m.role||"member")===r?"selected":""}>${{admin:"Admin",builder:"Builder",member:"Member"}[r]}</option>`).join("")}
        </select>`:""}
        ${(hasBuilderRole()&&m.id!==ME)?`<button class="btn btn-danger btn-sm dash-rm-btn" data-mid="${m.id}">Remove</button>`:""}
      </td>
    </tr>`;
  };

  const fileRow=(f)=>{
    const up=memberById(f.uploadedBy);
    const acc=Object.values(f.access||{}).filter(t=>t&&t!=="none").length;
    const folder=DIR.folders.find(x=>x.id===f.folderId);
    return `<tr data-fid="${f.id}" style="cursor:pointer">
      <td style="padding:10px 12px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(f.name)}</td>
      <td style="padding:10px 12px;font-size:12px;color:var(--slate)">${up?esc(up.name):"-"}</td>
      <td style="padding:10px 12px;font-family:var(--num);font-size:12px;color:var(--slate)">${f.kind==="link"?"Link":fmtSize(f.size)}</td>
      <td style="padding:10px 12px;font-family:var(--num);font-size:12px;color:var(--slate)">${acc}</td>
      <td style="padding:10px 12px;font-size:12px;color:var(--slate)">${folder?esc(folder.name):"—"}</td>
    </tr>`;
  };

  const allNotifs=[...DIR.notifications||[]].sort((a,b)=>b.createdAt-a.createdAt).slice(0,40);
  const activityRows=allNotifs.map(n=>{
    const m=memberById(n.by); const f=DIR.files.find(x=>x.id===n.fileId);
    const kindLabel={comment:"commented on",mention:"mentioned someone in",upload:"uploaded",access:"updated access to",replace:"replaced"}[n.kind]||n.kind;
    return `<div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)">
      ${m?avatar(m):`<div class="avatar" style="width:28px;height:28px;font-size:10px;background:#D5DADE">?</div>`}
      <div style="flex:1;font-size:13px"><span style="font-weight:600">${m?esc(m.name):"?"}</span> ${kindLabel} <span style="font-weight:500">${f?esc(f.name):"a file"}</span></div>
      <div style="font-family:var(--num);font-size:10.5px;color:var(--slate-2);white-space:nowrap">${timeAgo(n.createdAt)}</div>
    </div>`;
  }).join("") || `<div style="font-size:13px;color:var(--slate-2);padding:20px 0">No activity yet.</div>`;

  const {ov,close}=modal(`
    <div class="modal-head">
      <div><h3>Dashboard</h3><div class="sub">${DIR.members.length} members · ${DIR.files.length} files</div></div>
      <button class="x" data-close>${I.x}</button>
    </div>
    <div class="modal-body" style="padding:0">
      <div style="display:flex;border-bottom:1px solid var(--line)">
        <button class="dash-tab" data-tab="members" style="flex:1;padding:12px;font-size:13px;font-weight:600;border-bottom:2px solid var(--accent)">Members</button>
        <button class="dash-tab" data-tab="files" style="flex:1;padding:12px;font-size:13px;font-weight:600;border-bottom:2px solid transparent">Files</button>
        <button class="dash-tab" data-tab="activity" style="flex:1;padding:12px;font-size:13px;font-weight:600;border-bottom:2px solid transparent">Activity</button>
      </div>
      <div style="padding:20px 24px">
        <div id="dt-members">
          <div style="display:flex;justify-content:flex-end;margin-bottom:12px">
            <button class="btn btn-primary btn-sm" id="dash-invite">${I.plus} Invite member</button>
          </div>
          <table style="width:100%;border-collapse:collapse;font-size:13px">
            <thead><tr style="border-bottom:1px solid var(--line);font-family:var(--display);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--slate-2)">
              <th style="padding:8px 12px;text-align:left;font-weight:600">Member</th><th style="padding:8px 12px;text-align:left;font-weight:600">Role</th><th style="padding:8px 12px;text-align:left;font-weight:600">Files</th><th style="padding:8px 12px;text-align:left;font-weight:600">Actions</th>
            </thead>
            <tbody id="dash-members-body">${DIR.members.map(memberRow).join("")}</tbody>
          </table>
        </div>
        <div id="dt-files" style="display:none">
          <table style="width:100%;border-collapse:collapse;font-size:13px">
            <thead><tr style="border-bottom:1px solid var(--line);font-family:var(--display);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--slate-2)">
              <th style="padding:8px 12px;text-align:left;font-weight:600">Name</th><th style="padding:8px 12px;text-align:left;font-weight:600">Uploader</th><th style="padding:8px 12px;text-align:left;font-weight:600">Size</th><th style="padding:8px 12px;text-align:left;font-weight:600">Shared with</th><th style="padding:8px 12px;text-align:left;font-weight:600">Folder</th>
            </thead>
            <tbody>${DIR.files.map(fileRow).join("")}</tbody>
          </table>
        </div>
        <div id="dt-activity" style="display:none">${activityRows}</div>
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-primary" data-close>Close</button></div>`,{wide:true});

  const tabs=ov.querySelectorAll(".dash-tab");
  tabs.forEach(t=>t.onclick=()=>{
    tabs.forEach(x=>{ x.style.borderBottomColor="transparent"; x.style.fontWeight="600"; });
    t.style.borderBottomColor="var(--accent)";
    ["members","files","activity"].forEach(id=>{ const el=ov.querySelector("#dt-"+id); if(el) el.style.display=id===t.dataset.tab?"block":"none"; });
  });

  ov.querySelectorAll("tr[data-fid]").forEach(row=>row.onclick=()=>{ close(); openFileDetail(row.dataset.fid); });

  const refreshMembers=()=>{
    const body=ov.querySelector("#dash-members-body"); if(!body) return;
    body.innerHTML=DIR.members.map(memberRow).join("");
    wireMembers();
  };
  const wireMembers=()=>{
    ov.querySelectorAll(".dash-role-sel").forEach(sel=>sel.onchange=async()=>{
      const mid=sel.dataset.mid; if(!mid) return;
      await loadDir();
      const m=DIR.members.find(x=>x.id===mid); if(!m) return;
      m.role=sel.value;
      if(!DIR.members.some(x=>x.role==="admin")){ m.role="admin"; sel.value="admin"; toast("At least one admin is required.", true); return; }
      await saveDir(); refreshMembers(); toast("Role updated");
    });
    ov.querySelectorAll(".dash-rm-btn").forEach(btn=>btn.onclick=async()=>{
      const mid=btn.dataset.mid; if(!confirm("Remove this member?")) return;
      await removeMember(mid, refreshMembers);
    });
  };
  wireMembers();
  ov.querySelector("#dash-invite").onclick=()=>{ close(); openInviteLink(); };
}

function openInviteLink(){
  const inviteUrl=window.location.origin+window.location.pathname+"?invite=1";
  const {ov}=modal(`
    <div class="modal-head"><div><h3>Invite member</h3><div class="sub">Share this link so teammates can join.</div></div><button class="x" data-close>${I.x}</button></div>
    <div class="modal-body">
      <div class="field"><label>Invite link</label>
        <div style="display:flex;gap:8px">
          <input type="text" id="inv-url" value="${esc(inviteUrl)}" readonly style="flex:1;font-family:var(--num);font-size:12px;background:var(--mist)"/>
          <button class="btn btn-primary btn-sm" id="inv-copy">Copy</button>
        </div>
      </div>
      <div class="field"><label>Default role</label>
        <select id="inv-role" style="height:40px;border:1px solid var(--line);border-radius:var(--radius);background:var(--input-bg);padding:0 10px;font-size:13px;width:100%">
          <option value="member">Member</option>
          <option value="builder">Builder</option>
        </select>
      </div>
      <div style="font-size:12.5px;color:var(--slate);background:var(--mist);border-radius:var(--radius);padding:12px 14px">Anyone with this link and your team's access code can join. The access code remains required for security.</div>
    </div>
    <div class="modal-foot"><button class="btn btn-primary" data-close>Done</button></div>`);
  ov.querySelector("#inv-copy").onclick=()=>{
    navigator.clipboard.writeText(inviteUrl).then(()=>toast("Invite link copied")).catch(()=>{ ov.querySelector("#inv-url").select(); document.execCommand("copy"); toast("Copied"); });
  };
}

function openSiteSettings(){
  if(!hasBuilderRole()){ toast("You need the Website builder role to access Site settings.", true); return; }
  if(!isBuilder()){ toast("Enable Website builder mode first — open your profile menu and switch it on.", true); return; }
  const w=DIR.workspace;
  const {ov,close}=modal(`
    <div class="modal-head"><div><h3>Site settings</h3><div class="sub">Edit the site without touching code — visible to everyone.</div></div><button class="x" data-close>${I.x}</button></div>
    <div class="modal-body">
      <div class="field"><label>Logo <span style="text-transform:none;letter-spacing:0;color:var(--slate-2)">(replaces the Frankel logo)</span></label>
        <div style="display:flex;align-items:center;gap:12px">
          ${w.logo?`<img id="ss-logo-prev" src="${w.logo}" alt="Logo" style="height:32px;display:block;object-fit:contain;border:1px solid var(--line);border-radius:var(--radius);padding:3px 6px;background:var(--paper)"/>`:`<div id="ss-logo-prev" style="height:32px;width:48px;background:var(--mist);border:1px solid var(--line);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--slate-2)">None</div>`}
          <label class="btn btn-ghost btn-sm" style="cursor:pointer">Upload<input type="file" id="ss-logo-inp" accept="image/*" style="display:none"/></label>
          ${w.logo?`<button class="btn btn-ghost btn-sm" id="ss-logo-clear">Remove</button>`:""}
        </div>
      </div>
      <div class="field"><label>Workspace name</label><input type="text" id="ss-name" value="${esc(w.name)}"/></div>
      <div class="field"><label>Accent color</label>
        <div style="display:flex;align-items:center;gap:12px">
          <input type="color" id="ss-accent" value="${w.accent||'#4A525A'}" style="width:52px;height:40px;padding:3px;border:1px solid var(--line);border-radius:var(--radius);background:var(--input-bg)"/>
          <button class="btn btn-ghost btn-sm" id="ss-accent-reset">Reset to default</button>
        </div>
      </div>
      <div class="field"><label>Welcome message <span style="text-transform:none;letter-spacing:0;color:var(--slate-2)">(shown on the empty library)</span></label><textarea id="ss-welcome" placeholder="e.g. Frankel Design Build — internal file library.">${esc(w.welcome||"")}</textarea></div>
      <div class="field"><label>Microsoft 365 / SharePoint site URL</label><input type="text" id="ss-sp" value="${esc(w.sharepoint||"")}" placeholder="https://frankel.sharepoint.com/sites/…"/></div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-accent" id="ss-save">Save site settings</button></div>`);
  let accent=w.accent||null;
  let newLogo=w.logo||null;
  ov.querySelector("#ss-accent").oninput=(e)=>{ accent=e.target.value; };
  ov.querySelector("#ss-accent-reset").onclick=()=>{ accent=null; ov.querySelector("#ss-accent").value="#4A525A"; };
  ov.querySelector("#ss-logo-inp").onchange=(e)=>{
    const file=e.target.files[0]; if(!file) return;
    const reader=new FileReader();
    reader.onload=()=>{
      newLogo=reader.result;
      const prev=ov.querySelector("#ss-logo-prev");
      if(prev.tagName==="IMG") prev.src=newLogo;
      else { const img=document.createElement("img"); img.id="ss-logo-prev"; img.src=newLogo; img.style.cssText="height:32px;display:block;object-fit:contain;border:1px solid var(--line);border-radius:var(--radius);padding:3px 6px;background:var(--paper)"; prev.replaceWith(img); }
    };
    reader.readAsDataURL(file);
  };
  const clearBtn=ov.querySelector("#ss-logo-clear"); if(clearBtn) clearBtn.onclick=()=>{ newLogo=null; const prev=ov.querySelector("#ss-logo-prev"); const ph=document.createElement("div"); ph.id="ss-logo-prev"; ph.style.cssText="height:32px;width:48px;background:var(--mist);border:1px solid var(--line);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--slate-2)"; ph.textContent="None"; prev.replaceWith(ph); };
  ov.querySelector("#ss-save").onclick=async()=>{
    const sp=ov.querySelector("#ss-sp").value.trim();
    if(sp && !/^https?:\/\//i.test(sp)){ toast("SharePoint URL must start with http(s)://", true); return; }
    await loadDir();
    DIR.workspace.name=ov.querySelector("#ss-name").value.trim()||DIR.workspace.name;
    DIR.workspace.accent=accent||null;
    DIR.workspace.logo=newLogo||null;
    DIR.workspace.welcome=ov.querySelector("#ss-welcome").value.trim();
    DIR.workspace.sharepoint=sp;
    await saveDir(); applyBranding(); close(); renderApp(); toast("Site settings saved");
  };
}

function openAdminPanel(){
  if(!isAdmin()){ toast("Administrators only.", true); return; }
  const {ov,close}=modal(`
    <div class="modal-head"><div><h3>Admin panel</h3><div class="sub">Members, roles, and the team access code.</div></div><button class="x" data-close>${I.x}</button></div>
    <div class="modal-body">
      <div class="field"><label>Members &amp; roles</label>
        <div class="admin-list" id="admin-list"></div>
        <button class="btn btn-ghost btn-sm" id="ad-add" style="margin-top:10px">${I.plus} Add member</button>
      </div>
      <div class="field"><label>Team access code <span style="text-transform:none;letter-spacing:0;color:var(--slate-2)">(one code, shared by everyone)</span></label>
        <div style="display:flex;gap:8px"><input type="text" id="ad-code" placeholder="Enter a new code to change it"/><button class="btn btn-accent btn-sm" id="ad-code-save">Update</button></div>
        <div style="font-size:11.5px;color:var(--slate-2);margin-top:8px">Share the new code with the team. Anyone signed in stays signed in.</div>
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-primary" data-close>Done</button></div>`);

  const roleOpts=(cur)=>["admin","builder","member"].map(r=>`<option value="${r}" ${cur===r?"selected":""}>${ {admin:"Administrator",builder:"Website builder",member:"Member"}[r] }</option>`).join("");
  const drawList=()=>{
    const list=ov.querySelector("#admin-list"); if(!list) return;
    list.innerHTML=DIR.members.map(m=>`
      <div class="admin-row" data-mid="${m.id}">
        ${avatar(m)}
        <span class="nm">${esc(m.name)}${m.id===ME?' <span style="color:var(--slate-2);font-size:11px">(you)</span>':''}</span>
        <select class="role-sel" ${m.id===ME?"disabled title='You cannot change your own role'":""}>${roleOpts(m.role||"member")}</select>
        ${m.id===ME?"":`<button class="admin-rm" title="Remove member">${I.x}</button>`}
      </div>`).join("");
    list.querySelectorAll(".admin-row").forEach(row=>{ const mid=row.dataset.mid;
      const sel=row.querySelector(".role-sel"); if(sel && !sel.disabled) sel.onchange=async()=>{ await loadDir(); const m=DIR.members.find(x=>x.id===mid); if(m) m.role=sel.value; if(!DIR.members.some(x=>x.role==="admin")){ m.role="admin"; sel.value="admin"; toast("At least one admin is required.", true); } await saveDir(); toast("Role updated"); };
      const rm=row.querySelector(".admin-rm"); if(rm) rm.onclick=()=> removeMember(mid, drawList);
    });
  };
  drawList();
  ov.querySelector("#ad-add").onclick=()=>{ openNewMember(drawList); };
  ov.querySelector("#ad-code-save").onclick=async()=>{ const c=ov.querySelector("#ad-code").value; if(c.length<4){ toast("Use at least 4 characters.", true); return; } await loadDir(); DIR.workspace.code=hashCode(c); await saveDir(); ov.querySelector("#ad-code").value=""; toast("Access code updated"); };
}

function removeMember(mid, after){
  const m=memberById(mid); if(!m) return;
  const {ov,close}=modal(`
    <div class="modal-head"><div><h3>Remove member</h3></div><button class="x" data-close>${I.x}</button></div>
    <div class="modal-body"><p style="font-size:14px;color:var(--ink-2)">Remove <strong>${esc(m.name)}</strong>? Their uploaded files stay in the library. Any access granted to them is revoked.</p></div>
    <div class="modal-foot"><button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-danger" id="rm-yes">Remove</button></div>`);
  ov.querySelector("#rm-yes").onclick=async()=>{
    await loadDir();
    DIR.members=DIR.members.filter(x=>x.id!==mid);
    DIR.files.forEach(f=>{ if(f.access) delete f.access[mid]; });
    if(!DIR.members.some(x=>x.role==="admin") && DIR.members[0]) DIR.members[0].role="admin";
    await saveDir(); close(); if(after) after(); renderApp(); toast("Member removed");
  };
}

async function exportBackup(){
  if(!isAdmin()){ toast("Administrators only.", true); return; }
  toast("Preparing backup…");
  const data={ app:"frankel-file-sharing", version:1, exportedAt:Date.now(), workspace:DIR.workspace, members:DIR.members, folders:DIR.folders, files:DIR.files, blobs:{}, thumbs:{} };
  for(const f of DIR.files){ if(f.kind!=="link"){ try{ const b=await getBlob(f.id); if(b) data.blobs[f.id]=b; const t=await store.get(THUMB(f.id),true); if(t) data.thumbs[f.id]=t; for(const h of (f.history||[])){ if(h.blobKey){ const hb=await getBlobAt(h.blobKey); if(hb) data.blobs[h.blobKey]=hb; } } }catch(e){} } }
  const blob=new Blob([JSON.stringify(data)],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a"); a.href=url; a.download="frankel-file-sharing-backup-"+new Date().toISOString().slice(0,10)+".json"; a.click();
  setTimeout(()=>URL.revokeObjectURL(url),4000);
  toast("Backup downloaded");
}

function importBackup(file, closeParent){
  if(!isAdmin()){ toast("Administrators only.", true); return; }
  const reader=new FileReader();
  reader.onload=async()=>{
    let data; try{ data=JSON.parse(reader.result); }catch(e){ toast("That file isn't a valid backup.", true); return; }
    if(!data || data.app!=="frankel-file-sharing" || !Array.isArray(data.files)){ toast("Unrecognized backup file.", true); return; }
    const {ov,close}=modal(`
      <div class="modal-head"><div><h3>Restore backup</h3><div class="sub">${data.files.length} files · ${ (data.members||[]).length } members</div></div><button class="x" data-close>${I.x}</button></div>
      <div class="modal-body"><p style="font-size:14px;color:var(--ink-2)">This <strong>replaces the entire current library</strong> with the backup from ${data.exportedAt?fmtDate(data.exportedAt):"the file"}. This can't be undone. Continue?</p></div>
      <div class="modal-foot"><button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-danger" id="imp-yes">Replace &amp; restore</button></div>`);
    ov.querySelector("#imp-yes").onclick=async()=>{
      DIR={ workspace:data.workspace||null, members:data.members||[], folders:data.folders||[], files:data.files||[] };
      await saveDir();
      for(const [k,val] of Object.entries(data.blobs||{})){ const key=k.startsWith("fdb.")?k:BLOB(k); try{ await setBlobAt(key,val); }catch(e){} }
      for(const [id,val] of Object.entries(data.thumbs||{})){ try{ await store.set(THUMB(id),val,true); }catch(e){} }
      applyBranding(); close(); if(closeParent)closeParent();
      if(!memberById(ME)) ME=null;
      render(); toast("Backup restored");
    };
  };
  reader.readAsText(file);
}

(async function init(){
  await loadDir();

  if(!DIR.workspace){
  DIR.workspace={};
  DIR.workspace.name="Frankel File Sharing";
  DIR.members=[
    {id:"m-admin-1",name:"Admin 1",color:"#C7CDD2",role:"admin",pin:null},
    {id:"m-builder",name:"Gabi Marchi",color:"#D5DADE",role:"builder",pin:null}
  ];
  DIR.folders=[];
  DIR.files=[];
  DIR.notifications=[];
  await saveDir();
  ME="m-builder";
  await store.set(ME_KEY,"m-builder",false);
}

  await loadSession();
  await loadSeen();
  await loadTheme();
  await loadFav();
  await loadSavedViews();
  await loadNotifPrefs();
  await loadPinned();
  await loadRailState();
  await loadBuilderMode();
  applyBranding();
  render();

  const _params=new URLSearchParams(location.search);
  if(_params.get("invite")){
    setTimeout(()=>{
      const codeInp=document.getElementById("access-code")||document.querySelector("input[type=password]");
      if(codeInp){ codeInp.focus(); }
      const banner=document.createElement("div");
      banner.style.cssText="position:fixed;top:0;left:0;right:0;z-index:999;background:var(--accent);color:var(--on-accent);text-align:center;padding:10px 16px;font-size:13.5px;font-weight:600;";
      banner.textContent="You've been invited! Enter your team's access code below to join.";
      document.body.prepend(banner);
      setTimeout(()=>banner.remove(),6000);
    },200);
  }
})();
