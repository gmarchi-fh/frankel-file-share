function renderMain(){
  const main=document.getElementById("main");
  let title, meta, crumb="", headActions="";
  const curFolder = VIEW.type==="folder" ? DIR.folders.find(x=>x.id===VIEW.folderId) : null;

  if(VIEW.type==="folder"){
    crumb=`<div class="crumb"><span data-nav="all" class="lnk" style="cursor:pointer">Library</span><span class="sep">/</span><span>${esc(curFolder?curFolder.name:"Folder")}</span></div>`;
    title = esc(curFolder?curFolder.name:"Folder");
    if(curFolder && canManageFolder(curFolder)) headActions=`<button class="btn btn-ghost btn-sm" id="back-btn">← Back</button><button class="btn btn-ghost btn-sm" id="manage-folder">${I.pencilEdit} Manage folder</button>`;
    else headActions=`<button class="btn btn-ghost btn-sm" id="back-btn">← Back</button>`;
  } else if(VIEW.type==="shared"){ title="Shared with me"; }
  else if(VIEW.type==="mine"){ title="My uploads"; }
  else if(VIEW.type==="fav"){ title="Favorites"; }
  else { title="All files"; }

  const files = filesForView();
  const showFolders = VIEW.type==="all" && !SEARCH && DIR.folders.some(folderVisible);
  const filterActive = FILTER.uploader || FILTER.type || FILTER.date;
  meta = `${files.length} file${files.length!==1?"s":""}${SEARCH?` matching “${esc(SEARCH)}”`:""}${filterActive?" · filtered":""}`;

  // filter bar
  const upOpts=`<option value="">Anyone</option>`+DIR.members.map(m=>`<option value="${m.id}" ${FILTER.uploader===m.id?"selected":""}>${esc(m.name)}</option>`).join("");
  const TYPE_GROUPS=[
    ["Documents",  ["PDF","DOCX","DOC","XLSX","XLS","PPTX","PPT","TXT","CSV","RTF","ODT","ODS","ODP","PAGES","NUMBERS","KEY"]],
    ["Images",     ["JPG","JPEG","PNG","GIF","SVG","WEBP","TIFF","TIF","BMP","HEIC","HEIF","RAW","CR2","NEF","ARW","DNG"]],
    ["Design & CAD",["AI","PSD","INDD","EPS","DWG","DXF","RVT","SKP","3DM","IFC","FBX","OBJ","STEP","STP","3DS","MAX"]],
    ["Video",      ["MP4","MOV","AVI","MKV","WMV","FLV","WEBM","M4V","MPG","MPEG"]],
    ["Audio",      ["MP3","WAV","AAC","FLAC","OGG","M4A","AIFF","WMA","OPUS"]],
    ["Archives",   ["ZIP","RAR","7Z","TAR","GZ","BZ2","DMG","ISO"]],
    ["Code & Web", ["HTML","CSS","JS","JSON","XML","PHP","PY","SQL","MD","YAML","SH"]],
  ];
  const typeOpts=`<option value="">All types</option>${TYPE_GROUPS.map(([g,exts])=>`<optgroup label="${g}">${exts.map(e=>`<option value="${e}"${FILTER.type===e?' selected':''}>${e}</option>`).join('')}</optgroup>`).join('')}<option value="LINK"${FILTER.type==='LINK'?' selected':''}>LINK</option>`;
  const dateOpts=[["","Any date"],["today","Today"],["yesterday","Yesterday"],["week","This week"],["last7","Last 7 days"],["month","This month"],["last30","Last 30 days"],["last90","Last 90 days"],["year","This year"]].map(([v,l])=>`<option value="${v}" ${FILTER.date===v?"selected":""}>${l}</option>`).join("");
  const filterBar=`<div class="filter-bar">
      <span class="flt-lbl">Added by</span>
      <select id="flt-up" class="flt">${upOpts}</select>
      <select id="flt-type" class="flt">${typeOpts}</select>
      <select id="flt-date" class="flt">${dateOpts}</select>
      ${filterActive?`<button class="btn btn-ghost btn-sm" id="flt-save">Save view</button><button class="btn btn-ghost btn-sm" id="flt-clear">Clear</button>`:""}
    </div>`;

  let body="";
  if(showFolders){
    body += `<div style="margin-bottom:30px">
      <div class="rail-title" style="padding:0 0 14px;color:var(--slate-2)">Folders</div>
      <div class="grid">${DIR.folders.filter(folderVisible).map(f=>`
        <div class="folder-card" data-folder="${f.id}" tabindex="0" role="button">
          <span class="ficon"${f.color?` style="color:${f.color}"`:""}>${I.folderBig}</span>
          <div><div class="fname">${esc(f.name)}</div><div class="fcount">${folderCount(f.id)} file${folderCount(f.id)!==1?"s":""}${(f.access&&Object.values(f.access).some(v=>v&&v!=="none"))?" · shared":""}</div></div>
        </div>`).join("")}</div></div>`;
  }

  if(files.length===0 && !showFolders){
    body += emptyState();
  } else if(files.length===0){
    body += `<div class="rail-title" style="padding:0 0 14px;color:var(--slate-2)">Files</div>`+emptyState(true);
  } else {
    if(showFolders) body += `<div class="rail-title" style="padding:0 0 14px;color:var(--slate-2)">Files</div>`;
    body += `<div class="grid">${files.map(fileCard).join("")}</div>`;
  }

  main.innerHTML = `${crumb}
    <div class="view-head"><div><h1>${title}</h1><div class="meta">${meta}</div></div><div class="head-actions">${headActions}</div></div>
    ${filterBar}
    ${body}`;

  main.querySelectorAll("[data-folder]").forEach(el=>{
    el.onclick=()=>{ VIEW={type:"folder",folderId:el.dataset.folder}; closeRail(); renderApp(); };
    el.onkeydown=(e)=>{ if(e.key==="Enter") el.click(); };
  });
  main.querySelectorAll(".card[data-file]").forEach(el=>{
    el.onclick=(e)=>{ if(e.target.closest(".fav-btn")) return; openFilePreview(el.dataset.file); };
    el.onkeydown=(e)=>{ if(e.key==="Enter") el.click(); };
  });
  main.querySelectorAll(".fav-btn").forEach(b=> b.onclick=async(e)=>{ e.stopPropagation(); await toggleFav(b.dataset.fav); renderMain(); });
  main.querySelectorAll(".lnk[data-nav]").forEach(el=> el.onclick=()=>{ VIEW={type:el.dataset.nav,folderId:null}; renderApp(); });

  const fu=main.querySelector("#flt-up"), ft=main.querySelector("#flt-type"), fd=main.querySelector("#flt-date");
  if(fu) fu.onchange=()=>{ FILTER.uploader=fu.value; renderMain(); };
  if(ft) ft.onchange=()=>{ FILTER.type=ft.value; renderMain(); };
  if(fd) fd.onchange=()=>{ FILTER.date=fd.value; renderMain(); };
  const fc=main.querySelector("#flt-clear"); if(fc) fc.onclick=()=>{ FILTER={uploader:"",type:"",date:""}; renderMain(); };
  const fs=main.querySelector("#flt-save"); if(fs) fs.onclick=saveCurrentView;
  const mf=main.querySelector("#manage-folder"); if(mf) mf.onclick=()=> openManageFolder(VIEW.folderId);
