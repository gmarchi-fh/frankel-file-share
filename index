    if(!dataUrl){ prev.innerHTML=`<div class="noprev"><div class="pi">${I.fileBig}</div>Preview unavailable<div class="mono">The file data could not be loaded.</div></div>`; }
    else if(isImg){
      prev.classList.add("has-annot");
      prev.innerHTML=`<div class="hl-stage" id="hlStage">
          <img id="hlImg" src="${dataUrl}" alt="${esc(f.name)}"/>
          <div class="hl-layer" id="hlLayer"></div>
          <div class="hl-capture" id="hlCapture"></div>
          <button class="hl-toggle" id="hlToggle" title="Draw a box on the image, then comment on it">✎ Highlight</button>
