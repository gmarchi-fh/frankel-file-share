function openUpload(){
  pending=[];
  const access={}; DIR.members.forEach(m=>{ if(m.id!==ME) access[m.id]="none"; });
  const folderOpts=`<option value="">— No folder —</option>`+DIR.folders.map(f=>`<option value="${f.id}" ${VIEW.type==="folder"&&VIEW.folderId===f.id?"selected":""}>${esc(f.name)}</option>`).join("");

  const {ov,close}=modal(`
    <div class="modal-head"><div><h3>Add to library</h3><div class="sub">You're the owner — set who receives access below.</div></div><button class="x" data-close>${I.x}</button></div>
    <div class="modal-body">
      <div class="seg" role="tablist" style="margin-bottom:20px">
        <button class="on" id="tab-file" data-tier="edit" style="padding:8px 16px">Upload file</button>
        <button id="tab-link" style="padding:8px 16px">Add by link</button>
      </div>

      <div id="pane-file">
        <div class="dropzone" id="dz">
          <div class="di">${I.upload.replace('width="15" height="15"','width="26" height="26"')}</div>
          <div class="dt">Drag files here, or click to browse</div>
          <div class="dh">Up to ${fmtSize(MAX_BYTES)} per file · docs, images, PDFs, and more · very large CAD/Revit → use “Add by link”</div>
          <input type="file" id="fi" multiple style="display:none"/>
        </div>
        <div class="filelist" id="fl"></div>
      </div>

      <div id="pane-link" style="display:none">
        <div class="note-block" style="border-color:var(--accent);margin-bottom:18px">
          For large Autodesk / Revit / CAD files, keep the file in SharePoint, BIM&nbsp;360 or Autodesk Docs and paste its share link here. The hub tracks it with the same per-person access — no size limit.
        </div>
        ${DIR.workspace.sharepoint?`<button class="btn btn-ghost btn-sm" id="sp-open" type="button" style="margin-bottom:14px">${I.m365} Open SharePoint to copy a link ↗</button>`:""}
        <div class="field"><label for="lk-name">Display name</label><input type="text" id="lk-name" placeholder="e.g. Hillside Residence — Central Model.rvt" autocomplete="off"/></div>
        <div class="field"><label for="lk-url">Share link (URL)</label><input type="text" id="lk-url" placeholder="https://…sharepoint.com/… or Autodesk Docs link" autocomplete="off"/></div>
        <div class="field"><label for="lk-size">File size <span style="text-transform:none;letter-spacing:0;color:var(--slate-2)">(optional label, e.g. 240 MB)</span></label><input type="text" id="lk-size" placeholder="240 MB" autocomplete="off"/></div>
      </div>

      <div style="height:4px"></div>
      <div class="field"><label for="dst">Folder</label><select id="dst">${folderOpts}</select></div>
      <div class="field"><label for="note">Note <span style="text-transform:none;letter-spacing:0;color:var(--slate-2)">(optional — a short description)</span></label><textarea id="note" placeholder="e.g. Client-ready proposal draft — final version for review."></textarea></div>
