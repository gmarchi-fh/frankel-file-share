const mem = new Map();
let usingFallback = false;   // true when not using the Claude preview's shared storage
let lsMode = false;          // true when persisting to this device's localStorage (hosted site)
function LS(){ try{ return (typeof window!=="undefined" && window.localStorage) ? window.localStorage : null; }catch(e){ return null; } }
const lsKey=(k,shared)=> (shared?"fdbs:":"fdbp:")+k;
const store = {
  async get(k, shared=true){
    if(window.storage && window.storage.get){
      try{ const r = await window.storage.get(k, shared); return r?r.value:null; }
      catch(e){ return null; }
    }
    usingFallback = true;
    const ls=LS();
    if(ls){ lsMode=true; try{ const v=ls.getItem(lsKey(k,shared)); return v===null?null:v; }catch(e){ return null; } }
    return mem.has(k)?mem.get(k):null;
  },
  async set(k,v,shared=true){
    if(window.storage && window.storage.set){
      try{ await window.storage.set(k,v,shared); return true; }
      catch(e){ toast("Storage limit reached for this item.", true); return false; }
    }
    usingFallback = true;
    const ls=LS();
    if(ls){ lsMode=true; try{ ls.setItem(lsKey(k,shared), v); return true; }
      catch(e){ toast("This device's storage is full — export a backup and remove some large files.", true); return false; } }
    mem.set(k,v); return true;
  },
  async del(k,shared=true){
    if(window.storage && window.storage.delete){
      try{ await window.storage.delete(k,shared); return true; }catch(e){ return false; }
    }
    const ls=LS();
    if(ls){ try{ ls.removeItem(lsKey(k,shared)); return true; }catch(e){} }
    mem.delete(k); return true;
  }
};

/* ---------- state ---------- */
let DIR = { workspace:null, members:[], folders:[], files:[] };
let ME = null;                 // signed-in memberId
let VIEW = { type:"all", folderId:null }; // all | shared | mine | folder | folders | members
let SEARCH = "";
let railOpen = false;

async function loadDir(){
  const raw = await store.get(DIR_KEY, true);
  if(raw){ try{ DIR = JSON.parse(raw); }catch(e){ DIR = {}; } }
  DIR.workspace ??= null; DIR.members ||= []; DIR.folders ||= []; DIR.files ||= []; DIR.notifications ||= [];
  DIR.folders.forEach(fo=>{ fo.access ??= {}; });
  // ensure every member has a role; guarantee at least one admin
  DIR.members.forEach(m=>{ if(!m.role) m.role="member"; });
  if(DIR.members.length && !DIR.members.some(m=>m.role==="admin")) DIR.members[0].role="admin";
}
async function saveDir(){ await store.set(DIR_KEY, JSON.stringify(DIR), true); }

/* session (per device) */
let SEEN = {};            // { fileId: lastOpenedTs }  (personal, per device)
let rememberMe = true;    // login "keep me signed in" choice
async function loadSession(){ const s = await store.get(SESSION_KEY, false); ME = (s && memberById(s)) ? s : null; }
async function signIn(memberId, remember=true){ ME = memberId; if(remember){ await store.set(SESSION_KEY, memberId, false); } else { await store.del(SESSION_KEY, false); } }
async function signOut(){ ME = null; await store.del(SESSION_KEY, false); SEARCH=""; VIEW={type:"all",folderId:null}; renderLogin(); }
async function loadSeen(){ const s = await store.get(SEEN_KEY, false); try{ SEEN = s?JSON.parse(s):{}; }catch(e){ SEEN={}; } }
async function markSeen(fileId){ SEEN[fileId]=Date.now(); await store.set(SEEN_KEY, JSON.stringify(SEEN), false); }
function unreadCount(f){ const last=SEEN[f.id]||0; return (f.comments||[]).filter(c=>c.at>last && c.by!==ME).length; }
function totalUnread(pred){ return visibleFiles().filter(f=> (!pred||pred(f)) && unreadCount(f)>0).length; }

/* theme (per device) */
let THEME='light';
function applyTheme(){ document.documentElement.setAttribute('data-theme', THEME==='dark'?'dark':'light'); }
async function loadTheme(){ const t=await store.get(THEME_KEY,false); THEME=(t==='dark')?'dark':'light'; applyTheme(); }
async function setTheme(t){ THEME=(t==='dark')?'dark':'light'; applyTheme(); await store.set(THEME_KEY,THEME,false); }

/* branding (workspace accent) */
function applyBranding(){
  const w=DIR.workspace||{};
  if(w.accent){ document.documentElement.style.setProperty('--accent', w.accent); } else { document.documentElement.style.removeProperty('--accent'); }
  const logoEl=document.querySelector(".brand img");
  if(logoEl && w.logo) logoEl.src=w.logo;
  else if(logoEl && !w.logo) logoEl.src=LOGO;
}

/* roles */
function myRole(){ const m=memberById(ME); return m?(m.role||'member'):'member'; }
function isAdmin(){ return myRole()==='admin'; }
let BUILDER_MODE = false; // builder must opt in each session
async function loadBuilderMode(){ const s=await store.get(BUILDER_KEY,false); BUILDER_MODE = s==='1'; }
async function setBuilderMode(on){ BUILDER_MODE=on; await store.set(BUILDER_KEY, on?'1':'0', false); }
function isBuilder(){ const r=myRole(); return r==='admin' || (r==='builder' && BUILDER_MODE); }
function hasBuilderRole(){ const r=myRole(); return r==='admin'||r==='builder'; }
function canManageFile(f){ return isAdmin() || canManage(myAccess(f)); }

/* favorites, filters, saved views (per device) */
let FAV=[]; let SAVED_VIEWS=[]; let FILTER={uploader:"",type:"",date:""};
async function loadFav(){ const s=await store.get(FAV_KEY,false); try{ FAV=s?JSON.parse(s):[]; }catch(e){ FAV=[]; } }
async function toggleFav(id){ if(FAV.includes(id)) FAV=FAV.filter(x=>x!==id); else FAV=[...FAV,id]; await store.set(FAV_KEY,JSON.stringify(FAV),false); }
async function loadSavedViews(){ const s=await store.get(FILTERS_KEY,false); try{ SAVED_VIEWS=s?JSON.parse(s):[]; }catch(e){ SAVED_VIEWS=[]; } }
async function saveSavedViews(){ await store.set(FILTERS_KEY,JSON.stringify(SAVED_VIEWS),false); }

/* notifications (shared; each targets one recipient) */
let NOTIF={enabled:true,dnd:false,show:"all"}; // per-device prefs
let PINNED=[]; // per-device pinned file ids
let RAIL_COLLAPSED={}; // per-device: which sidebar sections are collapsed
const RAIL_KEY="fdb.rail.v1";
async function loadRailState(){ const s=await store.get(RAIL_KEY,false); try{ RAIL_COLLAPSED=s?JSON.parse(s):{}; }catch(e){ RAIL_COLLAPSED={}; } }
async function saveRailState(){ await store.set(RAIL_KEY,JSON.stringify(RAIL_COLLAPSED),false); }
async function loadNotifPrefs(){ const s=await store.get(NOTIF_KEY,false); try{ NOTIF=Object.assign({enabled:true,dnd:false,show:"all"}, s?JSON.parse(s):{}); }catch(e){ NOTIF={enabled:true,dnd:false,show:"all"}; } }
async function saveNotifPrefs(){ await store.set(NOTIF_KEY,JSON.stringify(NOTIF),false); }
async function loadPinned(){ const s=await store.get(PIN_KEY,false); try{ PINNED=s?JSON.parse(s):[]; }catch(e){ PINNED=[]; } }
async function togglePin(id){ if(PINNED.includes(id)) PINNED=PINNED.filter(x=>x!==id); else PINNED=[...PINNED,id]; await store.set(PIN_KEY,JSON.stringify(PINNED),false); }
function myNotifs(){ return (DIR.notifications||[]).filter(n=>n.to===ME).sort((a,b)=>b.at-a.at); }
function myNotifsShown(){ const l=myNotifs(); if(NOTIF.show==="mention") return l.filter(n=>n.kind==="mention"); if(NOTIF.show==="comment") return l.filter(n=>n.kind==="comment"); return l; }
function unreadNotifs(){ if(!NOTIF.enabled||NOTIF.dnd) return 0; return myNotifs().filter(n=>!n.read).length; }
async function pushNotif(to, kind, fileId, commentId, by){
  if(!to || to===by) return;
  DIR.notifications = DIR.notifications || [];
  DIR.notifications.push({id:uid(), to, kind, fileId, commentId, by, at:Date.now(), read:false});
  if(DIR.notifications.length>400) DIR.notifications = DIR.notifications.slice(-400);
}
async function markNotifsRead(){ let ch=false; (DIR.notifications||[]).forEach(n=>{ if(n.to===ME && !n.read){ n.read=true; ch=true; } }); if(ch){ await saveDir(); } }

/* lightweight, non-cryptographic obfuscation for the access code / PINs (app-level gate, not real security) */
function hashCode(str){ let h=5381; for(let i=0;i<str.length;i++){ h=((h<<5)+h+str.charCodeAt(i))>>>0; } return "h"+h.toString(36); }

/* ---------- helpers ---------- */
const uid = ()=> Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);
const memberById = (id)=> DIR.members.find(m=>m.id===id);
const initialsOf = (name)=> name.trim().split(/\s+/).slice(0,2).map(s=>s[0]||"").join("").toUpperCase() || "?";
function fmtSize(b){ if(b<1024)return b+" B"; if(b<1048576)return (b/1024).toFixed(0)+" KB"; return (b/1048576).toFixed(1)+" MB"; }
function fmtDate(ts){ const d=new Date(ts); return d.toLocaleDateString(undefined,{month:"short",day:"numeric",year:"numeric"}); }
function esc(s){ return (s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function extOf(name){ const m=/\.([a-z0-9]+)$/i.exec(name||""); return m?m[1].toUpperCase():"FILE"; }

/* access resolution for current user */
const TIER_RANK={none:0,view:1,readonly:2,edit:3,owner:4};
function tierMax(a,b){ return (TIER_RANK[a]||0)>=(TIER_RANK[b]||0)?a:b; }
function folderAccessFor(folderId, memberId){
  if(!folderId) return "none";
  const fo=DIR.folders.find(x=>x.id===folderId); if(!fo) return "none";
  return (fo.access && fo.access[memberId]) || "none";
}
function myAccess(file){
  if(!ME) return "none";
  if(file.uploadedBy===ME) return "owner";
  let a = (file.access && file.access[ME]) || "none";
  a = tierMax(a, folderAccessFor(file.folderId, ME)); // folder sharing grants a baseline
  return a;
}
const canView = a => a==="owner"||a==="edit"||a==="readonly"||a==="view";
const canDownload = a => a==="owner"||a==="edit"||a==="readonly";
const canManage = a => a==="owner"||a==="edit";
function canManageFolder(fo){ return isAdmin() || (fo && fo.createdBy===ME); }
function folderVisible(fo){ return isAdmin() || fo.createdBy===ME || folderAccessFor(fo.id,ME)!=="none" || visibleFiles().some(f=>f.folderId===fo.id); }
function typeOf(f){ if(f.kind==="link") return "link"; const m=f.mime||""; if(m.startsWith("image/")) return "image"; if(m==="application/pdf") return "pdf"; if(m.startsWith("text/")) return "text"; return "other"; }

function dateBucket(ts){
  const now=new Date(); const d=new Date(ts);
  const startToday=new Date(now.getFullYear(),now.getMonth(),now.getDate()).getTime();
  const startYest=startToday-86400000;
  const dow=(now.getDay()+6)%7; const startWeek=startToday-dow*86400000; // Monday
  const startMonth=new Date(now.getFullYear(),now.getMonth(),1).getTime();
  if(ts>=startToday) return "today";
  if(ts>=startYest) return "yesterday";
  if(ts>=startWeek) return "week";
  if(ts>=startMonth) return "month";
  return "older";
}
function matchesFilters(f){
  if(FILTER.uploader && f.uploadedBy!==FILTER.uploader) return false;
  if(FILTER.type){ const ft=f.kind==="link"?"LINK":extOf(f.name); if(ft!==FILTER.type) return false; }
  if(FILTER.date){
    const ts=f.uploadedAt, now2=Date.now();
    const st=new Date(); st.setHours(0,0,0,0); const stn=st.getTime();
    if(FILTER.date==="today" && ts<stn) return false;
    if(FILTER.date==="yesterday" && (ts<stn-86400000||ts>=stn)) return false;
    if(FILTER.date==="week"){const dow=(new Date().getDay()+6)%7; if(ts<stn-dow*86400000) return false;}
    if(FILTER.date==="last7" && ts<now2-7*86400000) return false;
    if(FILTER.date==="month"){const sm=new Date(new Date().getFullYear(),new Date().getMonth(),1).getTime();if(ts<sm) return false;}
    if(FILTER.date==="last30" && ts<now2-30*86400000) return false;
    if(FILTER.date==="last90" && ts<now2-90*86400000) return false;
    if(FILTER.date==="year"){const sy=new Date(new Date().getFullYear(),0,1).getTime();if(ts<sy) return false;}
  }
  return true;
}
function visibleFiles(){
  return DIR.files.filter(f=>{
    const a = myAccess(f);
    if(!canView(a)) return false;
    if(SEARCH){
      const up=memberById(f.uploadedBy);
      const hay=(f.name+" "+(f.note||"")+" "+(up?up.name:"")).toLowerCase();
      if(!hay.includes(SEARCH.toLowerCase())) return false;
    }
    return true;
  });
}
function filesForView(){
  let files = visibleFiles().filter(matchesFilters);
  if(VIEW.type==="folder") files = files.filter(f=>f.folderId===VIEW.folderId);
  else if(VIEW.type==="shared") files = files.filter(f=> f.uploadedBy!==ME && myAccess(f)!=="none");
  else if(VIEW.type==="mine") files = files.filter(f=> f.uploadedBy===ME);
  else if(VIEW.type==="fav") files = files.filter(f=> FAV.includes(f.id));
  return files.sort((a,b)=> b.uploadedAt - a.uploadedAt);
}
function folderCount(folderId){ return visibleFiles().filter(f=>f.folderId===folderId).length; }

/* ---------- toast ---------- */
function toast(msg, warn=false){
  const w=document.getElementById("toasts");
  const t=document.createElement("div"); t.className="toast"+(warn?" warn":""); t.textContent=msg;
  w.appendChild(t); setTimeout(()=>{ t.style.opacity="0"; setTimeout(()=>t.remove(),250); }, 2600);
}

