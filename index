<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light dark" />
<title>Frankel File Sharing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<script src="https://alcdn.msauth.net/browser/2.38.3/js/msal-browser.min.js"></script>
<style>
  :root{
    --ink:#1A1D21;
    --ink-2:#33383D;
    --slate:#6B7480;
    --slate-2:#9AA2AA;
    --mist:#F0F2F4;
    --line:#E4E7EA;
    --canvas:#FFFFFF;
    --paper:#FFFFFF;
    --accent:#4A525A;
    --accent-soft:#EDEFF1;
    --edit:#4A525A;
    --read:#7A828A;
    --view:#AEB6BD;
    --danger:#7E5C5F;
    --radius:4px;
    --shadow:0 1px 2px rgba(26,29,33,.04), 0 8px 24px rgba(26,29,33,.05);
    --shadow-lift:0 2px 4px rgba(26,29,33,.05), 0 18px 40px rgba(26,29,33,.09);
    --sans:'Inter', system-ui, -apple-system, sans-serif;
    --display:'Montserrat', 'Helvetica Neue', Arial, sans-serif;
    --mono:'Space Mono', ui-monospace, SFMono-Regular, monospace;
    --num:'Inter', system-ui, -apple-system, sans-serif;
    --btn-fill:#E6E9EC; --btn-fill-hover:#D9DDE1; --btn-border:#D3D8DC;
    --tier-owner-bg:#E2E5E8;
    --seg-none:#ECEEF0; --seg-view:#E1E4E7; --seg-read:#D3D8DC; --seg-edit:#C4CAD0;
    --topbar-bg:rgba(255,255,255,.86);
    --input-bg:#FFFFFF;
    --on-accent:#FFFFFF;
    --preview-doc:#FFFFFF;
  }
  html[data-theme="dark"]{
    --ink:#E9ECEF; --ink-2:#C7CDD2; --slate:#9AA2AA; --slate-2:#79828A;
    --mist:#272E35; --line:#343C44; --canvas:#1E242A; --paper:#252D34;
    --accent:#8FB3C6; --accent-soft:#263540;
    --edit:#8FB3C6; --read:#9AA2AA; --view:#6B747C; --danger:#C98A86;
    --btn-fill:#303940; --btn-fill-hover:#3B444C; --btn-border:#424C54;
    --tier-owner-bg:#303940;
    --seg-none:#2A3138; --seg-view:#323C44; --seg-read:#3D4A54; --seg-edit:#4A5860;
    --topbar-bg:rgba(30,36,42,.88);
    --input-bg:#252D34;
    --on-accent:#1E242A;
    --preview-doc:#252D34;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.4);
    --shadow-lift:0 2px 4px rgba(0,0,0,.35), 0 18px 40px rgba(0,0,0,.5);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  html{color-scheme:light}
  html[data-theme="dark"]{color-scheme:dark}
  input,select,textarea,option{background-color:var(--input-bg);color:var(--ink)}
  option{background:var(--input-bg);color:var(--ink)}
  body{
    font-family:var(--sans);
    color:var(--ink);
    background:var(--canvas);
    -webkit-font-smoothing:antialiased;
    line-height:1.5;
  }
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
  input,select,textarea{font-family:inherit;font-size:14px;color:var(--ink)}
  a{color:inherit}
  ::selection{background:var(--accent-soft)}

  /* ---------- App shell ---------- */
  .app{min-height:100vh;display:flex;flex-direction:column}

  .topbar{
    position:sticky;top:0;z-index:40;
    background:var(--topbar-bg);
    backdrop-filter:saturate(140%) blur(12px);
    border-bottom:1px solid var(--line);
    display:flex;align-items:center;gap:20px;
    padding:0 24px;height:66px;
  }
  .brand{display:flex;align-items:center;gap:14px;flex-shrink:0;background:none;border:none;cursor:pointer;padding:0}
  .brand:hover{opacity:.75}
  .brand img{height:26px;display:block}
  .brand .divider{width:1px;height:26px;background:var(--line)}
  .brand .subtitle{
    font-family:var(--display);font-weight:600;font-size:11px;
    letter-spacing:.22em;text-transform:uppercase;color:var(--slate);
    white-space:nowrap;
  }
  .topbar .search{flex:1;max-width:460px;position:relative}
  .topbar .search input{
    width:100%;height:40px;border:1px solid var(--line);border-radius:var(--radius);
    background:var(--paper);padding:0 14px 0 38px;transition:border-color .15s, box-shadow .15s;
  }
  .topbar .search input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .topbar .search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--slate-2)}
  .topbar .spacer{flex:1}
  .topbar-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}

  .identity{position:relative}
  .identity-btn{
    display:flex;align-items:center;gap:9px;height:40px;padding:0 12px;
    border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);
    transition:border-color .15s;
  }
  .identity-btn:hover{border-color:var(--slate-2)}
  .identity-btn .avatar{width:24px;height:24px;border-radius:50%;font-size:8.5px}
  .identity .menu .avatar{width:36px;height:36px;font-size:13px;flex-shrink:0}
  .identity-btn .who{display:flex;flex-direction:column;align-items:flex-start;line-height:1.1}
  .identity-btn .who .lbl{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate-2)}
  .identity-btn .who .nm{font-size:13px;font-weight:600}
  .identity-btn .caret{color:var(--slate-2)}

  .avatar{
    display:inline-flex;align-items:center;justify-content:center;
    border-radius:50%;font-family:var(--display);font-weight:600;color:#20252B;
    letter-spacing:.02em;flex-shrink:0;
  }

  .btn{
    display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;
    border-radius:var(--radius);font-size:13px;font-weight:600;letter-spacing:.01em;
    transition:transform .12s, background .15s, border-color .15s, opacity .15s;white-space:nowrap;
  }
  .btn:active{transform:translateY(1px)}
  .btn-primary{background:var(--btn-fill);color:var(--ink);border:1px solid var(--btn-border)}
  .btn-primary:hover{background:var(--btn-fill-hover)}
  .btn-ghost{background:transparent;border:1px solid var(--line);color:var(--ink)}
  .btn-ghost:hover{border-color:var(--slate-2)}
  .btn-accent{background:var(--btn-fill);color:var(--ink);border:1px solid var(--btn-border)}
  .btn-accent:hover{background:var(--btn-fill-hover)}
  .btn-danger{background:transparent;border:1px solid var(--line);color:var(--danger)}
  .btn-danger:hover{border-color:var(--danger)}
  .btn[disabled]{opacity:.4;cursor:not-allowed;transform:none}
  .btn-sm{height:34px;padding:0 12px;font-size:12px}

  /* ---------- Layout ---------- */
  .layout{flex:1;display:grid;grid-template-columns:260px 1fr;align-items:start}
  .rail{
    position:sticky;top:66px;align-self:start;height:calc(100vh - 66px);overflow-y:auto;
    border-right:1px solid var(--line);background:var(--paper);padding:22px 16px;
  }
  .rail-group+.rail-group{margin-top:26px}
  .rail-title{
    font-family:var(--display);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--slate-2);padding:0 10px 10px;display:flex;align-items:center;justify-content:space-between;
  }
  .rail-title button{color:var(--slate-2)}
  .rail-title button:hover{color:var(--accent)}
  .rail-title .toggle-caret{transition:transform .15s}
  .rail-title.collapsed .toggle-caret{transform:rotate(-90deg)}
  .rail-group.collapsed>:not(.rail-title){display:none}
  .nav-item{
    display:flex;align-items:center;gap:10px;width:100%;text-align:left;
    padding:9px 10px;border-radius:var(--radius);font-size:13.5px;color:var(--ink-2);
    transition:background .12s,color .12s;
  }
  .nav-item .ic{color:var(--slate-2);display:flex}
  .nav-item .count{margin-left:auto;font-family:var(--num);font-size:11px;color:var(--slate-2)}
  .nav-item:hover{background:var(--mist)}
  .nav-item.active{background:var(--mist);color:var(--ink);font-weight:600;box-shadow:inset 2px 0 0 var(--slate)}
  .nav-item.active .ic,.nav-item.active .count{color:var(--ink)}
  .nav-item.folder .ic{color:var(--slate)}
  .nav-item.active.folder .ic{color:var(--slate)}

  .roster-item{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:var(--radius)}
  .roster-item .avatar{width:26px;height:26px;font-size:9px}
  .roster-item .nm{font-size:13px}
  .roster-item .you-tag{margin-left:auto;font-family:var(--num);font-size:9px;letter-spacing:.1em;color:var(--accent);border:1px solid var(--accent-soft);padding:2px 6px;border-radius:99px}

  /* ---------- Main ---------- */
  .main{padding:30px 34px 80px;min-width:0}
  .crumb{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--slate);margin-bottom:6px;font-family:var(--display);letter-spacing:.06em;text-transform:uppercase}
  .crumb .sep{color:var(--slate-2)}
  .view-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:26px;flex-wrap:wrap}
  .view-head h1{font-family:var(--display);font-weight:700;font-size:26px;letter-spacing:-.01em}
  .view-head .meta{font-size:13px;color:var(--slate);margin-top:4px}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}

  .card{
    background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
    overflow:hidden;transition:transform .16s, box-shadow .16s, border-color .16s;cursor:pointer;
    display:flex;flex-direction:column;
  }
  .card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lift);border-color:transparent}
  .card:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .thumb{
    height:132px;background:var(--mist);display:flex;align-items:center;justify-content:center;
    position:relative;overflow:hidden;border-bottom:1px solid var(--line);
  }
  .thumb img{width:100%;height:100%;object-fit:cover}
  .thumb .filetype{
    font-family:var(--num);font-size:11px;letter-spacing:.15em;color:var(--slate);
    position:absolute;top:10px;left:12px;
  }
  .thumb .ficon{color:var(--slate-2)}
  .card-body{padding:14px 15px 15px}
  .card .fname{font-size:14px;font-weight:600;line-height:1.35;word-break:break-word}
  .card .fmeta{font-family:var(--num);font-size:11px;color:var(--slate-2);margin-top:6px;display:flex;gap:8px;flex-wrap:wrap}
  .card .frow{display:flex;align-items:center;justify-content:space-between;margin-top:13px;gap:8px}
  .stack{display:flex}
  .stack .avatar{width:22px;height:22px;font-size:8px;border:2px solid var(--paper);margin-left:-6px}
  .stack .avatar:first-child{margin-left:0}
  .stack .more{width:22px;height:22px;border-radius:50%;background:var(--mist);color:var(--slate);
    font-family:var(--num);font-size:9px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--paper);margin-left:-6px}
  .tier-badge{font-family:var(--num);font-size:9px;letter-spacing:.1em;text-transform:uppercase;
    padding:3px 7px;border-radius:99px;white-space:nowrap}
  .tier-owner{background:var(--tier-owner-bg);color:var(--ink);border:1px solid var(--slate-2)}
  .tier-edit{background:var(--accent-soft);color:var(--accent)}
  .tier-read{background:var(--mist);color:var(--slate)}
  .tier-view{background:var(--mist);color:var(--slate-2)}

  .folder-card{
    background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
    padding:18px;cursor:pointer;transition:transform .16s, box-shadow .16s, border-color .16s;
    display:flex;align-items:center;gap:14px;
  }
  .folder-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lift);border-color:transparent}
  .folder-card .ficon{color:var(--accent)}
  .folder-card .fname{font-weight:600;font-size:15px;font-family:var(--display)}
  .folder-card .fcount{font-family:var(--num);font-size:11px;color:var(--slate-2);margin-top:2px}

  /* ---------- Empty / onboarding ---------- */
  .empty{
    max-width:520px;margin:60px auto;text-align:center;padding:44px 34px;
    background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
  }
  .empty .mark{width:46px;height:46px;margin:0 auto 20px;color:var(--accent)}
  .empty h2{font-family:var(--display);font-weight:700;font-size:20px;margin-bottom:8px}
  .empty p{color:var(--slate);font-size:14px;margin-bottom:22px}

  .onboard-wrap{min-height:calc(100vh - 66px);display:flex;align-items:center;justify-content:center;padding:24px}
  .onboard{width:100%;max-width:440px;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:38px 34px}
  .onboard .eyebrow{font-family:var(--display);font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
  .onboard h2{font-family:var(--display);font-weight:700;font-size:22px;margin-bottom:8px}
  .onboard p{color:var(--slate);font-size:13.5px;margin-bottom:24px}

  /* ---------- Forms ---------- */
  .field{margin-bottom:18px}
  .field label{display:block;font-family:var(--display);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--slate);margin-bottom:8px}
  .field input[type=text],.field textarea,.field select{
    width:100%;height:42px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);padding:0 13px;transition:border-color .15s, box-shadow .15s;
  }
  .field textarea{height:auto;padding:11px 13px;resize:vertical;min-height:74px}
  .field input:focus,.field textarea:focus,.field select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .inline-form{display:flex;gap:8px}
  .inline-form input{flex:1}

  /* ---------- Modal ---------- */
  .overlay{position:fixed;inset:0;background:rgba(120,128,136,.26);backdrop-filter:blur(2px);z-index:100;display:flex;align-items:flex-start;justify-content:center;padding:40px 20px;overflow-y:auto}
  .modal{background:var(--paper);border-radius:var(--radius);box-shadow:var(--shadow-lift);width:100%;max-width:560px;margin:auto;animation:pop .18s ease}
  .modal.wide{max-width:640px}
  @keyframes pop{from{opacity:0;transform:translateY(8px) scale(.99)}to{opacity:1;transform:none}}
  .modal-head{display:flex;align-items:center;justify-content:space-between;padding:22px 26px;border-bottom:1px solid var(--line)}
  .modal-head h3{font-family:var(--display);font-weight:700;font-size:17px}
  .modal-head .sub{font-size:12px;color:var(--slate);margin-top:3px}
  .modal-head .x{width:34px;height:34px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--slate)}
  .modal-head .x:hover{background:var(--mist);color:var(--ink)}
  .modal-body{padding:24px 26px}
  .modal-foot{padding:18px 26px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px;align-items:center}

  /* dropzone */
  .dropzone{border:1.5px dashed var(--line);border-radius:var(--radius);padding:30px 20px;text-align:center;transition:border-color .15s, background .15s;cursor:pointer}
  .dropzone:hover,.dropzone.drag{border-color:var(--accent);background:var(--accent-soft)}
  .dropzone .di{color:var(--slate-2);margin-bottom:10px}
  .dropzone .dt{font-size:13.5px;font-weight:600}
  .dropzone .dh{font-size:11.5px;color:var(--slate-2);margin-top:5px;font-family:var(--num)}
  .filelist{margin-top:14px;display:flex;flex-direction:column;gap:8px}
  .filerow{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--line);border-radius:var(--radius);font-size:13px}
  .filerow .fn{flex:1;font-weight:500;word-break:break-word}
  .filerow .fs{font-family:var(--num);font-size:11px;color:var(--slate-2)}
  .filerow .rm{color:var(--slate-2);width:24px;height:24px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center}
  .filerow .rm:hover{background:var(--mist);color:var(--danger)}
  .filerow.bad{border-color:var(--danger);color:var(--danger)}

  /* ---------- Access stamp (signature element) ---------- */
  .stamp{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
  .stamp-head{display:flex;align-items:center;justify-content:space-between;background:var(--mist);color:var(--ink);padding:9px 14px;border-bottom:1px solid var(--line)}
  .stamp-head .t{font-family:var(--display);font-size:10px;letter-spacing:.2em;text-transform:uppercase}
  .stamp-head .rev{font-family:var(--num);font-size:10px;color:var(--slate-2)}
  .quick{display:flex;gap:8px;padding:12px 14px;border-bottom:1px solid var(--line);flex-wrap:wrap}
  .quick .qb{font-family:var(--num);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line);padding:6px 10px;border-radius:99px;color:var(--slate)}
  .quick .qb:hover{border-color:var(--accent);color:var(--accent)}
  .acc-row{display:flex;align-items:center;gap:12px;padding:11px 14px;border-bottom:1px solid var(--line)}
  .acc-row:last-child{border-bottom:none}
  .acc-row .who{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
  .acc-row .who .nm{font-size:13.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .acc-row .who .avatar{width:28px;height:28px;font-size:9.5px}
  .acc-row .owner-lock{font-family:var(--num);font-size:10px;letter-spacing:.08em;color:var(--slate-2);text-transform:uppercase}

  .seg{display:inline-flex;border:1px solid var(--line);border-radius:99px;overflow:hidden;background:var(--paper)}
  .seg button{
    font-family:var(--num);font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;
    padding:6px 11px;color:var(--slate);transition:background .12s,color .12s;border-right:1px solid var(--line);
  }
  .seg button:last-child{border-right:none}
  .seg button:hover{background:var(--mist)}
  .seg button.on{color:var(--ink)}
  .seg button.on[data-tier=none]{background:var(--seg-none)}
  .seg button.on[data-tier=view]{background:var(--seg-view)}
  .seg button.on[data-tier=readonly]{background:var(--seg-read)}
  .seg button.on[data-tier=edit]{background:var(--seg-edit)}

  /* preview */
  .preview{background:var(--mist);border:1px solid var(--line);border-radius:var(--radius);min-height:200px;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:20px}
  .preview img{max-width:100%;max-height:440px;display:block}
  .preview iframe{width:100%;height:440px;border:none;background:var(--preview-doc)}
  .preview .noprev{text-align:center;color:var(--slate);padding:44px}
  .preview .noprev .pi{color:var(--slate-2);margin-bottom:12px}
  .preview .noprev .mono{font-family:var(--num);font-size:12px;margin-top:6px;color:var(--slate-2)}
  .detail-meta{display:grid;grid-template-columns:1fr 1fr;gap:14px 24px;margin-bottom:22px}
  .detail-meta .k{font-family:var(--display);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--slate-2);margin-bottom:3px}
  .detail-meta .v{font-size:13.5px;font-weight:500}
  .detail-meta .v.mono{font-family:var(--num);font-weight:400;font-size:12.5px}
  .note-block{background:var(--canvas);border-left:2px solid var(--accent);padding:12px 15px;border-radius:0 var(--radius) var(--radius) 0;font-size:13.5px;color:var(--ink-2);margin-bottom:22px}

  /* comments */
  .comments{border-top:1px solid var(--line);padding-top:20px}
  .c-title{font-family:var(--display);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--slate);margin-bottom:14px;display:flex;align-items:center;gap:8px}
  .c-count{font-family:var(--num);font-size:11px;color:var(--slate-2);background:var(--mist);border-radius:99px;padding:1px 8px;letter-spacing:0}
  .c-list{display:flex;flex-direction:column;gap:14px;margin-bottom:16px}
  .c-empty{font-size:13px;color:var(--slate-2);padding:6px 0 2px}
  .c-item{display:flex;gap:11px}
  .c-item .avatar{width:30px;height:30px;font-size:10px;flex-shrink:0}
  .c-main{flex:1;min-width:0}
  .c-head{display:flex;align-items:center;gap:9px;margin-bottom:3px}
  .c-name{font-size:13px;font-weight:600}
  .c-time{font-family:var(--num);font-size:10.5px;color:var(--slate-2)}
  .c-del{margin-left:auto;width:22px;height:22px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--slate-2)}
  .c-del svg{width:13px;height:13px}
  .c-del:hover{background:var(--mist);color:var(--danger)}
  .c-text{font-size:13.5px;color:var(--ink-2);line-height:1.5;white-space:pre-wrap;word-break:break-word}
