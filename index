  const menu=document.createElement("div"); menu.className="fc-menu";
  menu.style.cssText=`left:${Math.min(x,window.innerWidth-200)}px;top:${Math.min(y,window.innerHeight-130)}px`;
  menu.innerHTML=`<div class="fc-title">Folder color</div><div class="swatches">${FOLDER_COLORS.map(c=>`<button class="swatch${fo.color===c?" on":""}" data-color="${c}" style="background:${c}" title="${c}"></button>`).join("")}<button class="swatch none${!fo.color?" on":""}" data-color="" title="No color"></button></div>`;
