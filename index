      <span style="margin-right:auto;font-size:11.5px;color:var(--slate-2)" id="up-status"></span>
      <button class="btn btn-ghost" data-close>Cancel</button>
      <button class="btn btn-accent" id="do-upload" disabled>Upload</button>
    </div>`, {wide:true});

  wireMatrix(ov.querySelector("#matrix"), access);

  let mode="file";
  const tabFile=ov.querySelector("#tab-file"), tabLink=ov.querySelector("#tab-link");
  const paneFile=ov.querySelector("#pane-file"), paneLink=ov.querySelector("#pane-link");
  function setMode(m){ mode=m;
    tabFile.classList.toggle("on", m==="file"); tabLink.classList.toggle("on", m==="link");
    paneFile.style.display = m==="file"?"":"none"; paneLink.style.display = m==="link"?"":"none";
    doBtn.textContent = m==="file"?"Upload":"Add link"; syncBtn();
  }
  tabFile.onclick=()=>setMode("file"); tabLink.onclick=()=>setMode("link");
  const spOpen=ov.querySelector("#sp-open"); if(spOpen) spOpen.onclick=()=> window.open(DIR.workspace.sharepoint,"_blank","noopener");
  ["lk-name","lk-url"].forEach(id=> ov.querySelector("#"+id).addEventListener("input",syncBtn));

  const dz=ov.querySelector("#dz"), fi=ov.querySelector("#fi"), fl=ov.querySelector("#fl"), doBtn=ov.querySelector("#do-upload"), status=ov.querySelector("#up-status");
  dz.onclick=()=>fi.click();
  ["dragover","dragenter"].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.add("drag");}));
  ["dragleave","drop"].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.remove("drag");}));
  dz.addEventListener("drop",e=> addFiles(e.dataTransfer.files));
  fi.addEventListener("change",e=> addFiles(e.target.files));

  function renderList(){
    fl.innerHTML=pending.map((p,i)=>`
      <div class="filerow ${p.tooBig?"bad":""}">
        <span class="fn">${esc(p.file.name)}</span>
        <span class="fs">${fmtSize(p.file.size)}${p.tooBig?" · too large":""}</span>
        <button class="rm" data-i="${i}" aria-label="Remove">${I.x}</button>
      </div>`).join("");
    fl.querySelectorAll(".rm").forEach(b=> b.onclick=()=>{ pending.splice(+b.dataset.i,1); renderList(); syncBtn(); });
    syncBtn();
  }
  function syncBtn(){
    if(mode==="link"){
      const nm=ov.querySelector("#lk-name").value.trim(), url=ov.querySelector("#lk-url").value.trim();
      doBtn.disabled=!(nm && /^https?:\/\//i.test(url));
    } else {
      doBtn.disabled=pending.filter(p=>!p.tooBig).length===0;
    }
  }

  async function addFiles(fileList){
    for(const file of Array.from(fileList)){
      const tooBig=file.size>MAX_BYTES;
      const entry={file,tooBig,dataUrl:null,thumb:null,arrayBuffer:null};
      pending.push(entry); renderList();
      if(!tooBig){
        const reader=new FileReader();
        reader.onload=()=>{ entry.dataUrl=reader.result;
          if(file.type.startsWith("image/")) entry.thumb=reader.result;
          syncBtn();
        };
        reader.readAsDataURL(file);
        const abReader=new FileReader();
        abReader.onload=()=>{ entry.arrayBuffer=abReader.result; };
        abReader.readAsArrayBuffer(file);
      }
    }
  }

  doBtn.onclick=async()=>{
    const folderId=ov.querySelector("#dst").value||null;
    const note=ov.querySelector("#note").value.trim();

    if(mode==="link"){
      const name=ov.querySelector("#lk-name").value.trim();
      const url=ov.querySelector("#lk-url").value.trim();
      const sizeLabel=ov.querySelector("#lk-size").value.trim();
      if(!name || !/^https?:\/\//i.test(url)){ toast("Add a name and a valid https link.", true); return; }
      doBtn.disabled=true; status.textContent="Saving…";
      await loadDir();
      DIR.files.push({
        id:uid(), kind:"link", name, url, sizeLabel, folderId,
        mime:"link", size:0, uploadedBy:ME, uploadedAt:Date.now(), note, access:{...access}, hasThumb:false
      });
      await saveDir(); close();
      if(folderId) VIEW={type:"folder",folderId};
      renderApp(); toast("Link added");
      return;
    }

    const ok=pending.filter(p=>!p.tooBig && p.dataUrl);
    if(ok.length===0){ toast("Files still loading — try again in a moment."); return; }
    doBtn.disabled=true; status.textContent="Uploading…";
    await loadDir(); // reduce clobber
    for(const p of ok){
      const id=uid();
      const okSet=await setBlob(id, p.dataUrl);
      if(!okSet){ toast(`Couldn't store "${p.file.name}" — over the size limit.`, true); continue; }
      if(p.arrayBuffer) await idbStore(id, p.arrayBuffer);
      let hasThumb=false;
      if((p.file.type||"").startsWith("image/")){
        const t=await makeThumb(p.dataUrl);
        if(t){ await store.set(THUMB(id), t, true); hasThumb=true; }
      }
      DIR.files.push({
        id, kind:"file", name:p.file.name, folderId, mime:p.file.type||"application/octet-stream",
        size:p.file.size, uploadedBy:ME, uploadedAt:Date.now(), note,
        access:{...access}, hasThumb
      });
    }
    await saveDir(); close();
    if(folderId) VIEW={type:"folder",folderId};
    renderApp(); toast(ok.length>1?`${ok.length} files uploaded`:"File uploaded");
  };
}

