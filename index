<script>
/* ============================================================
   Frankel File Sharing — client-side shared, access-controlled file library
   Persistence: window.storage (shared scope) with in-memory fallback.
   ============================================================ */

const LOGO = "data:image/png;base64,";
const DIR_KEY = "fdb.dir.v1";
const SESSION_KEY = "fdb.session.v1";   // per-device signed-in member
const SEEN_KEY = "fdb.seen.v1";         // per-device: last time this member opened each file
const THEME_KEY = "fdb.theme.v1";       // per-device: light | dark
const FAV_KEY = "fdb.fav.v1";           // per-device: favorite file ids
const FILTERS_KEY = "fdb.filters.v1";   // per-device: saved views
const NOTIF_KEY = "fdb.notif.v1";       // per-device: notification preferences
const PIN_KEY = "fdb.pin.v1";           // per-device: files pinned to sidebar
const BUILDER_KEY = "fdb.builder.v1";  // per-device: builder mode on/off
const BLOB = (id)=>"fdb.blob."+id;
const THUMB = (id)=>"fdb.thumb."+id;
// Files are stored in the shared key-value store; each key holds <5 MB, so large files are
// split across chunk keys transparently. Raised to the practical maximum for a browser-only app.
const CHUNK = 4_000_000;               // chars per chunk (safely under the 5 MB key limit)
const MAX_BYTES = 25 * 1024 * 1024;    // 25 MB per direct upload (very large CAD/Revit still better as links)

/* chunk-aware blob storage: transparently splits big data URLs across multiple keys */
async function setBlobAt(key, dataUrl){
  await delBlobAt(key); // clear any previous value/chunks
  if(dataUrl.length <= CHUNK){ return await store.set(key, dataUrl, true); }
  const n = Math.ceil(dataUrl.length / CHUNK);
  for(let i=0;i<n;i++){ const ok = await store.set(key+".c"+i, dataUrl.slice(i*CHUNK,(i+1)*CHUNK), true); if(!ok){ // rollback
      for(let j=0;j<=i;j++) await store.del(key+".c"+j, true); return false; } }
  return await store.set(key, "__CHUNKED__:"+n, true);
}
async function getBlobAt(key){
  const head = await store.get(key, true);
  if(head==null) return null;
  if(typeof head==="string" && head.startsWith("__CHUNKED__:")){
    const n=parseInt(head.slice(12),10); let out="";
    for(let i=0;i<n;i++){ const c=await store.get(key+".c"+i, true); if(c==null) return null; out+=c; }
    return out;
  }
  return head;
}
async function delBlobAt(key){
  const head = await store.get(key, true);
  if(typeof head==="string" && head.startsWith("__CHUNKED__:")){
    const n=parseInt(head.slice(12),10);
    for(let i=0;i<n;i++) await store.del(key+".c"+i, true);
  }
  await store.del(key, true);
}
const setBlob=(id,d)=>setBlobAt(BLOB(id),d);
const getBlob=(id)=>getBlobAt(BLOB(id));
const delBlob=(id)=>delBlobAt(BLOB(id));

let _idb=null;
async function openIDB(){
  if(_idb) return _idb;
  return new Promise((res,rej)=>{
    const req=indexedDB.open("frankel-files",1);
    req.onupgradeneeded=e=>e.target.result.createObjectStore("blobs");
    req.onsuccess=e=>{ _idb=e.target.result; res(_idb); };
    req.onerror=()=>rej(req.error);
  });
}
async function idbStore(fileId,arrayBuffer){
  try{
    const db=await openIDB();
    return new Promise((res,rej)=>{
      const tx=db.transaction("blobs","readwrite");
      tx.objectStore("blobs").put(arrayBuffer,"file-"+fileId);
      tx.oncomplete=res; tx.onerror=()=>rej(tx.error);
    });
  }catch(e){}
}
async function idbGet(fileId,mime){
  try{
    const db=await openIDB();
    return new Promise((res)=>{
      const req=db.transaction("blobs","readonly").objectStore("blobs").get("file-"+fileId);
      req.onsuccess=()=>{ if(req.result){ res(new Blob([req.result],{type:mime||"application/octet-stream"})); } else res(null); };
      req.onerror=()=>res(null);
    });
  }catch(e){ return null; }
}
async function idbDel(fileId){
  try{
    const db=await openIDB();
    return new Promise(res=>{ const tx=db.transaction("blobs","readwrite"); tx.objectStore("blobs").delete("file-"+fileId); tx.oncomplete=res; });
  }catch(e){}
}
async function getFileBlob(fileId,mime){
  const b=await idbGet(fileId,mime); if(b) return b;
  const d=await getBlob(fileId); if(!d) return null;
  const res=await fetch(d); return res.blob();
}

// downscale an image dataURL into a small JPEG thumbnail (keeps the directory record light)
function makeThumb(dataUrl){
  return new Promise((res)=>{
    const img=new Image();
    img.onload=()=>{
      const max=440; let {width:w,height:h}=img;
      const scale=Math.min(1, max/Math.max(w,h)); w=Math.round(w*scale); h=Math.round(h*scale);
      const c=document.createElement("canvas"); c.width=w; c.height=h;
      c.getContext("2d").drawImage(img,0,0,w,h);
      try{ res(c.toDataURL("image/jpeg",0.62)); }catch(e){ res(null); }
    };
    img.onerror=()=>res(null);
    img.src=dataUrl;
  });
}

