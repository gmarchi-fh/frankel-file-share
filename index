async function m365LoadSites(ov){
  const grid=ov.querySelector("#m365-grid"); const crumb=ov.querySelector("#m365-crumb");
  if(!grid) return;
  grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2);font-size:13px">Loading SharePoint sites…</div>`;
  crumb.innerHTML=`<span style="font-weight:600;color:var(--ink)">Sites</span>`;
  const data=await graphFetch("/sites?search=*");
  if(!data||!data.value){ grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2);font-size:13px">Could not load sites. Check your permissions.</div>`; return; }
  grid.innerHTML=data.value.map(s=>`
    <button class="m365-item" data-siteid="${esc(s.id)}" data-name="${esc(s.displayName||s.name)}" style="background:var(--mist);border:1px solid var(--line);border-radius:var(--radius);padding:14px;text-align:left;cursor:pointer;transition:border-color .15s">
      <div style="color:var(--accent);margin-bottom:8px">${I.m365}</div>
      <div style="font-size:13px;font-weight:600;word-break:break-word">${esc(s.displayName||s.name)}</div>
      <div style="font-size:11px;color:var(--slate-2);margin-top:3px">SharePoint site</div>
    </button>`).join("")||`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2);font-size:13px">No sites found.</div>`;
  grid.querySelectorAll(".m365-item[data-siteid]").forEach(b=>{ b.onmouseenter=()=>b.style.borderColor="var(--accent)"; b.onmouseleave=()=>b.style.borderColor="var(--line)"; b.onclick=()=>m365LoadDrives(ov,b.dataset.siteid,b.dataset.name); });
}

async function m365LoadDrives(ov, siteId, siteName){
  const grid=ov.querySelector("#m365-grid"); const crumb=ov.querySelector("#m365-crumb"); if(!grid) return;
  grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2);font-size:13px">Loading document libraries…</div>`;
  crumb.innerHTML=`<button class="m365-back" style="color:var(--accent);font-size:13px;background:none;border:none;cursor:pointer">Sites</button><span style="color:var(--slate-2)">›</span><span style="font-weight:600;color:var(--ink)">${esc(siteName)}</span>`;
  crumb.querySelector(".m365-back").onclick=()=>m365LoadSites(ov);
  const data=await graphFetch(`/sites/${siteId}/drives`);
  if(!data||!data.value){ grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2)">Could not load document libraries.</div>`; return; }
  grid.innerHTML=data.value.map(d=>`
    <button class="m365-item" data-driveid="${esc(d.id)}" data-name="${esc(d.name)}" style="background:var(--mist);border:1px solid var(--line);border-radius:var(--radius);padding:14px;text-align:left;cursor:pointer;transition:border-color .15s">
