      group.classList.toggle("collapsed");
      await saveRailState();
    };
  });

  document.getElementById("upload-btn").onclick=openUpload;
  document.getElementById("new-folder").onclick=openNewFolder;
  document.getElementById("new-member").onclick=()=>openNewMember();
  document.getElementById("id-btn").onclick=toggleIdentity;
  document.getElementById("bell-btn").onclick=openNotifications;
  document.getElementById("home-link").onclick=()=>{ VIEW={type:"all",folderId:null}; FILTER={uploader:"",type:"",date:""}; SEARCH=""; closeRail(); renderApp(); };
  const m365=document.getElementById("m365-link");
  if(m365) m365.onclick=()=>{ closeRail(); if(DIR.workspace.sharepoint) window.open(DIR.workspace.sharepoint,"_blank","noopener"); else openM365Info(); };
  document.querySelectorAll(".pinned-item").forEach(b=> b.onclick=(e)=>{ if(e.target.closest(".sv-rm")) return; closeRail(); openFileDetail(b.dataset.pinfile); });
  document.querySelectorAll("[data-pinrm]").forEach(b=> b.onclick=async(e)=>{ e.stopPropagation(); await togglePin(b.dataset.pinrm); renderApp(); });
  document.querySelectorAll(".saved-view").forEach(b=> b.onclick=(e)=>{ if(e.target.closest(".sv-rm")) return; const v=SAVED_VIEWS.find(x=>x.id===b.dataset.sv); if(!v)return; FILTER={uploader:v.uploader||"",type:v.type||"",date:v.date||""}; VIEW={type:v.base||"all",folderId:null}; closeRail(); renderApp(); });
  document.querySelectorAll(".sv-rm").forEach(b=> b.onclick=async(e)=>{ e.stopPropagation(); SAVED_VIEWS=SAVED_VIEWS.filter(x=>x.id!==b.dataset.svrm); await saveSavedViews(); renderApp(); });

  document.getElementById("ham").onclick=()=> railOpen?closeRail():openRail();
  document.getElementById("scrim").onclick=closeRail;
  const dashBtn=document.getElementById("dash-btn"); if(dashBtn) dashBtn.onclick=()=>{ closeRail(); openAdminDashboard(); };
}

