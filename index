const FOLDER_COLORS_F=["#E05252","#E87830","#CAA820","#44AA52","#26A8C8","#4460D8","#9448D8","#D44898"];
let _fcHideTimer=null;
let _fcFolderId=null;

function showFolderColorFloat(folderId, anchorEl){
  clearTimeout(_fcHideTimer);
  _fcFolderId=folderId;
  let panel=document.getElementById("fc-float");
  if(!panel){
    panel=document.createElement("div");
    panel.id="fc-float";
    panel.className="fc-float";
    panel.innerHTML=`<span class="fc-float-label">Color</span>`+FOLDER_COLORS_F.map(c=>`<span class="fc-float-sw" data-color="${c}" style="background:${c}"></span>`).join("");
    document.body.appendChild(panel);
    panel.addEventListener("mouseenter",()=>clearTimeout(_fcHideTimer));
    panel.addEventListener("mouseleave",()=>{ _fcHideTimer=setTimeout(hideFolderColorFloat,180); });
    panel.querySelectorAll(".fc-float-sw").forEach(sw=>{
      sw.addEventListener("click",async()=>{
        const col=sw.dataset.color;
        if(!_fcFolderId) return;
