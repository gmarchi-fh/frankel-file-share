        ${navItem("all", I.grid, "All files", totalVisible, "", totalUnread())}
        ${navItem("shared", I.shared, "Shared with me", visibleFiles().filter(f=>f.uploadedBy!==ME).length, "", totalUnread(f=>f.uploadedBy!==ME))}
        ${navItem("mine", I.mine, "My uploads", DIR.files.filter(f=>f.uploadedBy===ME).length)}
        ${navItem("fav", I.star, "Favorites", FAV.filter(id=>visibleFiles().some(f=>f.id===id)).length)}
      </div>
      ${(()=>{ const pins=PINNED.map(id=>DIR.files.find(f=>f.id===id)).filter(f=>f&&canView(myAccess(f))); return pins.length?`<div class="rail-group"><div class="rail-title">Pinned</div>${pins.map(f=>`<button class="nav-item pinned-item" data-pinfile="${f.id}"><span class="ic">${I.pin}</span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(f.name)}</span><button class="sv-rm" data-pinrm="${f.id}" aria-label="Unpin">${I.x}</button></button>`).join("")}</div>`:""; })()}
