    <div class="modal-foot"><button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-accent" id="pin-go">Sign in</button></div>`);
  const inp=ov.querySelector("#pin"); inp.focus();
  const go=async()=>{ if(hashCode(inp.value)!==m.pin){ toast("Incorrect PIN.", true); inp.value=""; inp.focus(); return; } close(); await signIn(mid, rememberMe); renderApp(); toast("Signed in as "+m.name.split(" ")[0]); };
  ov.querySelector("#pin-go").onclick=go; inp.addEventListener("keydown",e=>{if(e.key==="Enter")go();});
}
function addSelfAtLogin(){
  const {ov,close}=modal(`
    <div class="modal-head"><div><h3>Add yourself</h3><div class="sub">Create your profile in ${esc(DIR.workspace.name)}.</div></div><button class="x" data-close>${I.x}</button></div>
