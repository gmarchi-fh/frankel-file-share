function pickMember(mid){
  const m=memberById(mid);
  if(!m.pin){ signIn(mid, rememberMe).then(()=>{ renderApp(); toast("Signed in as "+m.name.split(" ")[0]); }); return; }
  const {ov,close}=modal(`
    <div class="modal-head"><div><h3>Enter PIN</h3><div class="sub">${esc(m.name)}</div></div><button class="x" data-close>${I.x}</button></div>
