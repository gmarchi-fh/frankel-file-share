let _msalApp = null;
let _m365Token = null;
let _m365Account = null;

async function getM365Token(){
  const cfg = DIR.workspace.m365||{};
  if(!cfg.clientId||!cfg.tenantId) return null;
  if(!_msalApp){
    _msalApp = new msal.PublicClientApplication({
      auth:{ clientId:cfg.clientId, authority:`https://login.microsoftonline.com/${cfg.tenantId}`, redirectUri:window.location.href.split('?')[0].split('#')[0] },
      cache:{ cacheLocation:"sessionStorage" }
    });
    await _msalApp.initialize();
  }
  const scopes=["Files.Read.All","Sites.Read.All","User.Read"];
  try{
    const accts=_msalApp.getAllAccounts();
    if(accts.length>0){ _m365Account=accts[0]; const r=await _msalApp.acquireTokenSilent({scopes,account:_m365Account}); _m365Token=r.accessToken; return _m365Token; }
    const r=await _msalApp.loginPopup({scopes}); _m365Account=r.account; const t=await _msalApp.acquireTokenSilent({scopes,account:_m365Account}); _m365Token=t.accessToken; return _m365Token;
  }catch(e){ _msalApp=null; _m365Token=null; _m365Account=null; return null; }
}

async function graphFetch(path){
  const tok=_m365Token||await getM365Token(); if(!tok) return null;
  try{
    const r=await fetch(`https://graph.microsoft.com/v1.0${path}`,{headers:{Authorization:`Bearer ${tok}`,"Content-Type":"application/json"}});
    if(!r.ok) return null; return await r.json();
  }catch(e){ return null; }
}

