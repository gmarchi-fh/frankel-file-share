  const a=myAccess(f);
  box.innerHTML=`<div class="ver-wrap">
    <div class="ver-title">${I.history} Version history <span class="c-count">${hist.length} previous</span></div>
    ${hist.map(h=>{ const by=memberById(h.by); return `<div class="ver-row">
      <div class="ver-main"><span class="ver-tag">v${h.rev}</span><span class="ver-name">${esc(h.name)}</span></div>
      <span class="ver-meta">${by?esc(by.name.split(" ")[0]):"—"} · ${fmtDate(h.at)} · ${fmtSize(h.size)}</span>
      ${canDownload(a)?`<button class="ver-dl" data-hkey="${h.blobKey}" data-hname="${esc(h.name)}" title="Download this version">${I.down}</button>`:""}
    </div>`;}).join("")}
  </div>`;
  box.querySelectorAll(".ver-dl").forEach(b=> b.onclick=async()=>{ const d=await getBlobAt(b.dataset.hkey); if(!d){ toast("Version data unavailable.", true); return; } const link=document.createElement("a"); link.href=d; link.download=b.dataset.hname; link.click(); });
