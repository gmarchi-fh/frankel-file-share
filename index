async function m365LoadFolder(ov, driveId, itemId, label, trail){
  const grid=ov.querySelector("#m365-grid"); const crumb=ov.querySelector("#m365-crumb"); if(!grid) return;
  grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2);font-size:13px">Loading…</div>`;
  const allTrail=[...trail,{label,fn:null}];
  crumb.innerHTML=allTrail.map((t,i)=>i<allTrail.length-1?`<button class="m365-bc" data-i="${i}" style="color:var(--accent);font-size:13px;background:none;border:none;cursor:pointer">${esc(t.label)}</button><span style="color:var(--slate-2)">›</span>`:`<span style="font-weight:600;color:var(--ink);font-size:13px">${esc(t.label)}</span>`).join("");
  crumb.querySelectorAll(".m365-bc").forEach(b=>{ const idx=+b.dataset.i; b.onclick=()=>allTrail[idx].fn&&allTrail[idx].fn(); });
  const endpoint=itemId==="root"?`/drives/${driveId}/root/children`:`/drives/${driveId}/items/${itemId}/children`;
  const data=await graphFetch(endpoint+"?$top=100&$select=id,name,file,folder,size,webUrl,lastModifiedDateTime");
  if(!data||!data.value){ grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2)">Could not load files.</div>`; return; }
  const items=data.value; if(!items.length){ grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:40px 0;color:var(--slate-2)">This folder is empty.</div>`; return; }
  grid.innerHTML=items.map(it=>{
    const isFolder=!!it.folder; const ext=it.name.split(".").pop().toUpperCase();
    const sz=it.size?fmtSize(it.size):"";
    return `<div class="m365-item" data-id="${esc(it.id)}" data-name="${esc(it.name)}" data-url="${esc(it.webUrl||"")}" data-isfolder="${isFolder}" style="background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:12px;cursor:pointer;transition:border-color .15s,box-shadow .15s;position:relative">
      <div style="height:56px;background:var(--mist);border-radius:2px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;color:var(--slate-2)">
        ${isFolder?`<span style="color:var(--accent)">${I.folder}</span>`:`<span style="font-family:var(--num);font-size:10px;letter-spacing:.1em;color:var(--slate)">${esc(ext)}</span>`}
      </div>
      <div style="font-size:12.5px;font-weight:600;word-break:break-word;line-height:1.35;margin-bottom:4px">${esc(it.name)}</div>
      ${!isFolder?`<div style="font-size:11px;color:var(--slate-2)">${sz}</div><button class="m365-add-btn" title="Add to hub" style="position:absolute;bottom:10px;right:10px;background:var(--btn-fill);border:1px solid var(--btn-border);border-radius:var(--radius);padding:3px 8px;font-size:11px;font-weight:600;cursor:pointer;display:none">+ Hub</button>`:""}
    </div>`;
  }).join("");
  grid.querySelectorAll(".m365-item").forEach(card=>{
    const isFolder=card.dataset.isfolder==="true";
    card.onmouseenter=()=>{ card.style.borderColor="var(--accent)"; card.style.boxShadow="var(--shadow-lift)"; const ab=card.querySelector(".m365-add-btn"); if(ab) ab.style.display="block"; };
    card.onmouseleave=()=>{ card.style.borderColor="var(--line)"; card.style.boxShadow=""; const ab=card.querySelector(".m365-add-btn"); if(ab) ab.style.display="none"; };
    if(isFolder){ card.onclick=(e)=>{ if(e.target.closest(".m365-add-btn")) return; m365LoadFolder(ov,driveId,card.dataset.id,card.dataset.name,allTrail); }; }
    else{
      card.onclick=(e)=>{ if(e.target.closest(".m365-add-btn")) return; if(card.dataset.url) window.open(card.dataset.url,"_blank","noopener"); };
      const ab=card.querySelector(".m365-add-btn");
      if(ab) ab.onclick=async(e)=>{ e.stopPropagation(); await addM365LinkToHub(card.dataset.url,card.dataset.name); toast("Added to hub as a link — set access in the file detail."); };
    }
  });
}

async function addM365LinkToHub(url, name){
  if(!url) return;
  await loadDir();
  const access={}; DIR.members.forEach(m=>{ if(m.id!==ME) access[m.id]="none"; });
  DIR.files.push({ id:uid(), name:name||url, kind:"link", mime:"link", size:0, uploadedBy:ME, uploadedAt:Date.now(), note:"", access, hasThumb:false, url });
  await saveDir(); renderApp();
}

