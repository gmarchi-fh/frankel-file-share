async function openFilePreview(fileId){
  const f=DIR.files.find(x=>x.id===fileId); if(!f) return;
  const a=myAccess(f);
  if(!canView(a)){ toast("You don't have access to this file.", true); return; }
  const isLink=f.kind==="link";
  const up=memberById(f.uploadedBy);
  const canDl=canDownload(a);
  const canMg=canManage(a);

  let previewHTML="";
  let blobUrl=null;

  if(isLink){
    previewHTML=`<div class="noprev" style="padding:44px;text-align:center"><div class="pi" style="margin-bottom:12px;color:var(--slate-2)">${I.linkBig||I.link}</div><div style="font-size:13px;color:var(--slate);word-break:break-all">${esc(f.url||"")}</div><a href="${esc(f.url||"#")}" target="_blank" rel="noopener" class="btn btn-primary" style="display:inline-flex;margin-top:16px">Open link</a></div>`;
  } else {
    const mime=f.mime||"";
    if(mime.startsWith("image/")){
      previewHTML=`<div style="display:flex;align-items:center;justify-content:center;min-height:400px"><img id="prev-img" src="" alt="${esc(f.name)}" style="max-width:100%;max-height:520px;display:block"/></div>`;
    } else if(mime==="application/pdf"){
      previewHTML=`<iframe id="prev-frame" src="" style="width:100%;height:520px;border:none;background:var(--preview-doc)"></iframe>`;
    } else if(mime.startsWith("video/")){
      previewHTML=`<video id="prev-vid" controls style="width:100%;max-height:520px;display:block"><source id="prev-vsrc" src="" type="${esc(mime)}"/></video>`;
    } else {
      previewHTML=`<div class="noprev" style="padding:44px;text-align:center"><div class="pi" style="margin-bottom:12px;color:var(--slate-2)">${I.file}</div><div style="font-size:14px;font-weight:600">${esc(f.name)}</div><div style="font-family:var(--num);font-size:11px;color:var(--slate-2);margin-top:4px">${fmtSize(f.size)}</div></div>`;
    }
  }

  const {ov,close}=modal(`
    <div class="modal-head">
      <div><h3 style="word-break:break-word">${esc(f.name)}</h3><div class="sub">${isLink?"External link":fmtSize(f.size)} · ${fmtDate(f.uploadedAt)}${up?" · "+esc(up.name):""}</div></div>
      <button class="x" data-close>${I.x}</button>
    </div>
    <div class="modal-body" style="padding:0">
      <div style="background:var(--mist);border-bottom:1px solid var(--line);min-height:400px;display:flex;align-items:stretch;justify-content:center;overflow:hidden">
        ${previewHTML}
      </div>
    </div>
    <div class="modal-foot">
      ${canMg?`<button class="btn btn-ghost btn-sm" id="fp-access">Manage access</button>`:""}
      <div style="flex:1"></div>
      ${(!isLink&&canDl)?`<button class="btn btn-primary btn-sm" id="fp-dl">${I.download} Download</button>`:""}
      <button class="btn btn-ghost btn-sm" data-close>Close</button>
    </div>`,{wide:true});

  if(!isLink){
    const mime=f.mime||"";
    const blob=await getFileBlob(f.id, mime);
    if(blob){
      blobUrl=URL.createObjectURL(blob);
      const img=ov.querySelector("#prev-img"); if(img) img.src=blobUrl;
      const fr=ov.querySelector("#prev-frame"); if(fr) fr.src=blobUrl;
      const vs=ov.querySelector("#prev-vsrc"); if(vs){ vs.src=blobUrl; const vid=ov.querySelector("#prev-vid"); if(vid) vid.load(); }
    }
    const dlBtn=ov.querySelector("#fp-dl");
    if(dlBtn) dlBtn.onclick=async()=>{
      const b=blob||await getFileBlob(f.id,mime);
      if(!b){ toast("File data not available.",true); return; }
      const u=URL.createObjectURL(b); const link=document.createElement("a"); link.href=u; link.download=f.name; link.click(); setTimeout(()=>URL.revokeObjectURL(u),1000);
    };
  }

  ov.querySelector("#fp-access")?.addEventListener("click",()=>{ close(); openFileDetail(f.id); });
  ov.addEventListener("close",()=>{ if(blobUrl) URL.revokeObjectURL(blobUrl); },{once:true});
}

function openAdminDashboard(){
