function wireApp(){
  const s=document.getElementById("search");
  const commit=(v)=>{ SEARCH=v; renderMain(); };
  s.addEventListener("input",e=>commit(e.target.value));
  const sm=document.getElementById("search-m"); if(sm) sm.addEventListener("input",e=>{SEARCH=e.target.value;renderMain();});

  document.querySelectorAll("[data-nav]").forEach(el=>{
    if(el.classList.contains("lnk")) return;
    el.onclick=()=>{ VIEW={type:el.dataset.nav,folderId:null}; closeRail(); renderApp(); };
  });
  document.querySelectorAll("[data-folder]").forEach(el=>{
    if(el.classList.contains("folder")) return; // handled below with dblclick logic
    el.onclick=()=>{ VIEW={type:"folder",folderId:el.dataset.folder}; closeRail(); renderApp(); };
  });
  let _folderClickTimer=null;
  document.querySelectorAll(".nav-item.folder[data-folder]").forEach(el=>{
    el.addEventListener("click",()=>{
      clearTimeout(_folderClickTimer);
      _folderClickTimer=setTimeout(()=>{ VIEW={type:"folder",folderId:el.dataset.folder}; closeRail(); renderApp(); },240);
    });
    el.addEventListener("dblclick",e=>{
      clearTimeout(_folderClickTimer);
      e.preventDefault(); e.stopPropagation();
      renameFolder(el.dataset.folder);
    });
    el.addEventListener("contextmenu",e=>{ e.preventDefault(); openFolderColorMenu(el.dataset.folder, e.clientX, e.clientY); });
    el.addEventListener("dragover",e=>{ e.preventDefault(); e.dataTransfer.dropEffect="move"; });
    el.addEventListener("dragenter",e=>{ el.style.opacity="0.6"; });
    el.addEventListener("dragleave",e=>{ el.style.opacity=""; });
    el.addEventListener("drop",async e=>{
      e.preventDefault(); e.stopPropagation();
      el.style.opacity="";
      const fileId=e.dataTransfer.getData("text/plain");
      if(!fileId) return;
      await loadDir();
      const f=DIR.files.find(x=>x.id===fileId); if(!f) return;
      const folderId=el.dataset.folder;
      if(f.folderId===folderId) return;
      const a=myAccess(f); if(!canManage(a)){ toast("You can't move this file.",true); return; }
      f.folderId=folderId; await saveDir(); renderApp(); toast(esc(f.name)+" moved to "+esc(DIR.folders.find(x=>x.id===folderId)?.name||"folder"));
    });
  });
  document.querySelectorAll(".card[data-file]").forEach(card=>{
    card.addEventListener("dragstart",e=>{ e.dataTransfer.effectAllowed="move"; e.dataTransfer.setData("text/plain",card.dataset.file); });
  });
  document.querySelectorAll(".rail-title[data-toggle]").forEach(title=>{
    title.style.cursor="pointer";
